APP_NAME=tracker
APP_ENV=development
APP_DEBUG=true
# The public URL, for links that leave the app (OAuth callbacks, emails)
APP_URL=http://localhost:8080
# go tool anetos key:generate
APP_KEY=
# The app's language and time zone (stored times are UTC whatever it is)
APP_LOCALE=en
APP_TIMEZONE=UTC
# Locales in URLs: none (default), prefix (/bn/about) or subdomain (bn.example.com)
# APP_LOCALE_STRATEGY=none

HTTP_ADDR=:8080

# memory (default) or database
CACHE_DRIVER=memory
# cookie (default) or database
SESSION_DRIVER=cookie
# sync (default: jobs run when dispatched), memory or database
QUEUE_DRIVER=database

# log (default: emails are written to the log) or smtp (MAIL_SMTP_URL)
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=hello@example.com
# MAIL_SMTP_URL=smtp://127.0.0.1:1025

# local (default: the storage/app directory) or memory
STORAGE_DRIVER=local
DB_DRIVER=sqlite
DB_NAME=database/app.db

# Full-text search (Search in queries, t.SearchIndex in migrations): simple
# (default) matches words as written, in any language; english also
# matches their other forms (run, running). Changing it needs
# go run . search:reindex
DB_SEARCH_LANGUAGE=simple
# default, or bm25
DB_SEARCH_RANKING=default

# Sign in with Google and GitHub (anetos make:auth): each is on once its
# client ID and secret are set. Register APP_URL/auth/google/callback
# (or /github/) as the callback URL with the provider.
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_GITHUB_CLIENT_ID=
SOCIAL_GITHUB_CLIENT_SECRET=
