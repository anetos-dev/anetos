# The production settings of tracker (anetos new): copy this file
# somewhere private (not the repository), fill it in, and give it to the
# app's environment: /etc/tracker/env for systemd, --env-file for
# docker run, the platform's settings on a PaaS. See the "Deploy" guide.
APP_NAME=tracker
APP_ENV=production
APP_DEBUG=false
# The public URL, for links in emails and social login callbacks.
APP_URL=https://example.com
# go tool anetos key:generate (keep it: it decrypts sessions and tokens)
APP_KEY=
APP_LOCALE=en
APP_TIMEZONE=UTC

# HTTP_ADDR=:8080 (the default; unset, a hosting platform's PORT is used)
# The reverse proxy or load balancer's address, so client IPs are right:
# 127.0.0.1 for a proxy on the same machine (systemd); with docker run -p,
# the Docker network's gateway (172.17.0.1); on a platform, its proxy's.
HTTP_TRUSTED_PROXIES=127.0.0.1

DB_DRIVER=sqlite
# The database file is DB_NAME, which the Dockerfile and the systemd
# unit set, in the data directory (keep it on a volume or disk).

# Shared by every instance: database (or redis, with its driver).
CACHE_DRIVER=database
SESSION_DRIVER=database
QUEUE_DRIVER=database

MAIL_DRIVER=smtp
MAIL_SMTP_URL=smtp://user:password@smtp.example.com:587
MAIL_FROM_ADDRESS=hello@example.com

STORAGE_DRIVER=local

# Log in with Google and GitHub (anetos make:auth): each is on once its
# client ID and secret are set. Register APP_URL/auth/google/callback
# (or /github/) as the callback URL with the provider.
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_GITHUB_CLIENT_ID=
SOCIAL_GITHUB_CLIENT_SECRET=
