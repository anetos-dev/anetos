package views

import (
	"anetos.dev/anetos/auth"
	"anetos.dev/anetos/i18n"
	"anetos.dev/anetos/view"
	"anetos.dev/anetos/web"

	"tracker/app/models"
	"tracker/views/ui"
)

// The account pages (anetos make:auth): yours to change. Their text is
// in locales/en/auth.yaml.

// SocialButton is a "Log in with …" button.
type SocialButton struct {
	Name  string // the provider in URLs: google
	Title string // its name for people: Google
}

// AccountMenu is the header's account links: the logged-in user's
// dashboard, settings and logout, or log in and register. make:auth adds
// it to the layout's header; setupAuth's sessions.Use(a.Middleware) lets
// every page with a session know who is logged in.
templ AccountMenu() {
	@ui.NavEnd() {
		if u, ok := auth.User[*models.User](ctx); ok {
			@ui.NavLink(web.MustURL(ctx, "dashboard"), u.Name, false)
			@ui.NavLink(web.MustURL(ctx, "settings"), i18n.T(ctx, "auth.settings.title"), false)
			@ui.NavItem() {
				@ui.PostButton(web.MustURL(ctx, "logout"), "POST", ui.Ghost) {
					{ i18n.T(ctx, "auth.dashboard.logout") }
				}
			}
		} else {
			@ui.NavLink(web.MustURL(ctx, "login"), i18n.T(ctx, "auth.login.title"), false)
			@ui.NavItem() {
				@ui.LinkButton(web.MustURL(ctx, "register"), ui.Primary|ui.Small) {
					{ i18n.T(ctx, "auth.register.title") }
				}
			}
		}
	}
}

// Register is the registration form.
templ Register(social []SocialButton) {
	@Layout(i18n.T(ctx, "auth.register.title")) {
		@ui.AuthCard(i18n.T(ctx, "auth.register.title")) {
			@ui.Form(web.MustURL(ctx, "register"), "POST", nil) {
				@ui.Field("name", i18n.T(ctx, "auth.fields.name"), "") {
					@ui.Input("name", "", view.Old(ctx, "name"), templ.Attributes{"autocomplete": "name"})
				}
				@ui.Field("email", i18n.T(ctx, "auth.fields.email"), "") {
					@ui.Input("email", "email", view.Old(ctx, "email"), templ.Attributes{"autocomplete": "email"})
				}
				@ui.Field("password", i18n.T(ctx, "auth.fields.password"), "") {
					@ui.Input("password", "password", "", templ.Attributes{"autocomplete": "new-password"})
				}
				@ui.Field("password_confirmation", i18n.T(ctx, "auth.fields.password_confirmation"), "") {
					@ui.Input("password_confirmation", "password", "", templ.Attributes{"autocomplete": "new-password"})
				}
				@ui.Actions() {
					@ui.Button(ui.Primary, nil) {
						{ i18n.T(ctx, "auth.register.submit") }
					}
				}
			}
			@socialButtons(social)
			@ui.Note() {
				{ i18n.T(ctx, "auth.register.have_account") } <a href={ web.URL(ctx, "login") }>{ i18n.T(ctx, "auth.login.title") }</a>
			}
		}
	}
}

// Login is the login form.
templ Login(social []SocialButton) {
	@Layout(i18n.T(ctx, "auth.login.title")) {
		@ui.AuthCard(i18n.T(ctx, "auth.login.title")) {
			@ui.Form(web.MustURL(ctx, "login"), "POST", nil) {
				@ui.Field("email", i18n.T(ctx, "auth.fields.email"), "") {
					@ui.Input("email", "email", view.Old(ctx, "email"), templ.Attributes{"autocomplete": "email"})
				}
				@ui.Field("password", i18n.T(ctx, "auth.fields.password"), "") {
					@ui.Input("password", "password", "", templ.Attributes{"autocomplete": "current-password"})
				}
				@ui.Checkbox("remember", i18n.T(ctx, "auth.login.remember"), false, nil)
				@ui.Actions() {
					@ui.Button(ui.Primary, nil) {
						{ i18n.T(ctx, "auth.login.submit") }
					}
					<a href={ web.URL(ctx, "password.request") }>{ i18n.T(ctx, "auth.forgot.title") }</a>
				}
			}
			@socialButtons(social)
			@ui.Note() {
				{ i18n.T(ctx, "auth.login.no_account") } <a href={ web.URL(ctx, "register") }>{ i18n.T(ctx, "auth.register.title") }</a>
			}
		}
	}
}

// ForgotPassword asks for the address to send a reset link to.
templ ForgotPassword() {
	@Layout(i18n.T(ctx, "auth.forgot.title")) {
		@ui.AuthCard(i18n.T(ctx, "auth.forgot.title")) {
			@ui.Note() {
				{ i18n.T(ctx, "auth.forgot.intro") }
			}
			@ui.Form(web.MustURL(ctx, "password.email"), "POST", nil) {
				@ui.Field("email", i18n.T(ctx, "auth.fields.email"), "") {
					@ui.Input("email", "email", view.Old(ctx, "email"), templ.Attributes{"autocomplete": "email"})
				}
				@ui.Actions() {
					@ui.Button(ui.Primary, nil) {
						{ i18n.T(ctx, "auth.forgot.submit") }
					}
				}
			}
		}
	}
}

// ResetPassword is the new-password form of a reset link.
templ ResetPassword(token string) {
	@Layout(i18n.T(ctx, "auth.reset.title")) {
		@ui.AuthCard(i18n.T(ctx, "auth.reset.title")) {
			@ui.Form(web.MustURL(ctx, "password.update"), "POST", nil) {
				<input type="hidden" name="token" value={ token }/>
				@ui.Field("password", i18n.T(ctx, "auth.fields.new_password"), "") {
					@ui.Input("password", "password", "", templ.Attributes{"autocomplete": "new-password"})
				}
				@ui.Field("password_confirmation", i18n.T(ctx, "auth.fields.password_confirmation"), "") {
					@ui.Input("password_confirmation", "password", "", templ.Attributes{"autocomplete": "new-password"})
				}
				@ui.Actions() {
					@ui.Button(ui.Primary, nil) {
						{ i18n.T(ctx, "auth.reset.submit") }
					}
				}
			}
		}
	}
}

// Dashboard shows the account and its API tokens; newToken is a token
// just created, shown once.
templ Dashboard(u *models.User, tokens []auth.Token, newToken string) {
	@Layout(i18n.T(ctx, "auth.dashboard.title")) {
		@ui.Narrow() {
			@ui.PageHeader(i18n.T(ctx, "auth.dashboard.hello", "name", u.Name), "") {
				@ui.LinkButton(web.MustURL(ctx, "settings"), ui.Secondary) {
					{ i18n.T(ctx, "auth.settings.title") }
				}
			}
			if u.EmailVerifiedAt == nil {
				@ui.Flash(ui.Warning) {
					<span>{ i18n.T(ctx, "auth.dashboard.verify") }</span>
					@ui.PostButton(web.MustURL(ctx, "verification.send"), "POST", ui.Secondary|ui.Small) {
						{ i18n.T(ctx, "auth.dashboard.resend") }
					}
				}
			}
			@ui.Card(i18n.T(ctx, "auth.tokens.title")) {
				@ui.Note() {
					{ i18n.T(ctx, "auth.tokens.intro") }
				}
				if newToken != "" {
					<p>{ i18n.T(ctx, "auth.tokens.new") }</p>
					<pre><code>{ newToken }</code></pre>
				}
				if len(tokens) > 0 {
					@ui.Table() {
						<tbody>
							for _, t := range tokens {
								<tr>
									<td>{ t.Name }</td>
									@ui.ActionsCell() {
										@ui.PostButton(web.MustURL(ctx, "tokens.destroy", t.ID), "POST", ui.Secondary|ui.Small) {
											{ i18n.T(ctx, "auth.tokens.revoke") }
										}
									}
								</tr>
							}
						</tbody>
					}
				}
				@ui.Form(web.MustURL(ctx, "tokens.store"), "POST", nil) {
					@ui.Field("name", i18n.T(ctx, "auth.tokens.name"), "") {
						@ui.Input("name", "", "", nil)
					}
					@ui.Button(ui.Primary, nil) {
						{ i18n.T(ctx, "auth.tokens.create") }
					}
				}
			}
		}
	}
}

// TwoFactorChallenge asks for the two-factor code, after the password.
templ TwoFactorChallenge() {
	@Layout(i18n.T(ctx, "auth.challenge.title")) {
		@ui.AuthCard(i18n.T(ctx, "auth.challenge.title")) {
			@ui.Note() {
				{ i18n.T(ctx, "auth.challenge.intro") }
			}
			@ui.Form(web.MustURL(ctx, "two-factor.challenge"), "POST", nil) {
				@ui.Field("code", i18n.T(ctx, "auth.fields.code"), "") {
					@ui.Input("code", "", "", templ.Attributes{"autocomplete": "one-time-code", "autofocus": true})
				}
				@ui.Actions() {
					@ui.Button(ui.Primary, nil) {
						{ i18n.T(ctx, "auth.challenge.submit") }
					}
				}
			}
		}
	}
}

// ConfirmPassword asks for the password again, before something
// sensitive.
templ ConfirmPassword() {
	@Layout(i18n.T(ctx, "auth.confirm.title")) {
		@ui.AuthCard(i18n.T(ctx, "auth.confirm.title")) {
			@ui.Note() {
				{ i18n.T(ctx, "auth.confirm.intro") }
			}
			@ui.Form(web.MustURL(ctx, "password.confirm"), "POST", nil) {
				@ui.Field("password", i18n.T(ctx, "auth.fields.password"), "") {
					@ui.Input("password", "password", "", templ.Attributes{"autocomplete": "current-password", "autofocus": true})
				}
				@ui.Actions() {
					@ui.Button(ui.Primary, nil) {
						{ i18n.T(ctx, "auth.confirm.submit") }
					}
				}
			}
		}
	}
}

// TwoFactorPage is what the two-factor page shows.
type TwoFactorPage struct {
	Status        auth.TwoFactorStatus
	Secret        string   // being set up: the key, to type in
	QR            string   // being set up: the QR code, as SVG
	RecoveryCodes []string // just made: shown once
}

// TwoFactor turns two-factor authentication on and off.
templ TwoFactor(p TwoFactorPage) {
	@Layout(i18n.T(ctx, "auth.two_factor.title")) {
		@ui.Narrow() {
			@ui.PageHeader(i18n.T(ctx, "auth.two_factor.title"), "") {
				@ui.LinkButton(web.MustURL(ctx, "settings"), ui.Secondary) {
					{ i18n.T(ctx, "auth.settings.title") }
				}
			}
			@ui.Card("") {
				if len(p.RecoveryCodes) > 0 {
					<p>{ i18n.T(ctx, "auth.two_factor.codes") }</p>
					<ul>
						for _, c := range p.RecoveryCodes {
							<li><code>{ c }</code></li>
						}
					</ul>
				}
				switch {
					case p.Status.On:
						<p>{ i18n.Plural(ctx, "auth.two_factor.on", p.Status.RecoveryCodes) }</p>
						@ui.Cluster() {
							@ui.PostButton(web.MustURL(ctx, "two-factor.recovery-codes"), "POST", ui.Secondary) {
								{ i18n.T(ctx, "auth.two_factor.new_codes") }
							}
							@ui.PostButton(web.MustURL(ctx, "two-factor.disable"), "POST", ui.Danger) {
								{ i18n.T(ctx, "auth.two_factor.disable") }
							}
						}
					case p.Status.Started:
						<p>{ i18n.T(ctx, "auth.two_factor.scan") }</p>
						<p>
							@templ.Raw(p.QR)
						</p>
						<p>{ i18n.T(ctx, "auth.two_factor.key") } <code>{ p.Secret }</code></p>
						@ui.Form(web.MustURL(ctx, "two-factor.confirm"), "POST", nil) {
							@ui.Field("code", i18n.T(ctx, "auth.fields.code"), "") {
								@ui.Input("code", "", "", templ.Attributes{"autocomplete": "one-time-code", "inputmode": "numeric"})
							}
							@ui.Button(ui.Primary, nil) {
								{ i18n.T(ctx, "auth.two_factor.confirm") }
							}
						}
					default:
						<p>{ i18n.T(ctx, "auth.two_factor.off") }</p>
						@ui.Form(web.MustURL(ctx, "two-factor.start"), "POST", nil) {
							@ui.Button(ui.Primary, nil) {
								{ i18n.T(ctx, "auth.two_factor.enable") }
							}
						}
				}
			}
		}
	}
}

// socialButtons shows a button per provider, and why a login failed.
templ socialButtons(buttons []SocialButton) {
	if len(buttons) > 0 {
		@ui.Note() {
			{ i18n.T(ctx, "auth.social.or") }
		}
		@ui.Stack() {
			for _, b := range buttons {
				@ui.LinkButton(web.MustURL(ctx, "social.redirect", b.Name), ui.Secondary|ui.Full) {
					{ i18n.T(ctx, "auth.social.login_with", "provider", b.Title) }
				}
			}
		}
	}
	@ui.FieldError("social")
}
