package views

import (
	"context"

	"anetos.dev/anetos/auth"
	"anetos.dev/anetos/i18n"
	"anetos.dev/anetos/view"
	"anetos.dev/anetos/web"

	"tracker/app/models"
	"tracker/views/ui"
)

// The account settings page (anetos make:auth): yours to change, and to
// add your own fields to. Its text is in locales/en/auth.yaml.

// Choice is an option of a select: its value and its name for people.
type Choice struct {
	Value, Title string
}

// localeOptions are the language select's options: the browser's
// language, then the app's.
func localeOptions(ctx context.Context, locales []Choice) []ui.Option {
	options := []ui.Option{{Value: "", Label: i18n.T(ctx, "auth.settings.language_auto")}}
	for _, l := range locales {
		options = append(options, ui.Option{Value: l.Value, Label: l.Title})
	}
	return options
}

// zoneOptions are the time zone select's options: the app's, then each
// zone.
func zoneOptions(ctx context.Context, zones []string) []ui.Option {
	options := []ui.Option{{Value: "", Label: i18n.T(ctx, "auth.settings.time_zone_app")}}
	for _, z := range zones {
		options = append(options, ui.Option{Value: z, Label: z})
	}
	return options
}

// SettingsPage is what the settings page shows.
type SettingsPage struct {
	User            *models.User
	Locales         []Choice // the app's languages
	TimeZones       []string // i18n.TimeZones
	EmailChange     bool     // users may change their address
	DeleteAccount   bool     // users may delete their account
	TwoFactor       bool     // two-factor sign-in is available
	TwoFactorStatus auth.TwoFactorStatus
}

// Settings is the account settings page.
templ Settings(p SettingsPage) {
	@Layout(i18n.T(ctx, "auth.settings.title")) {
		@ui.Narrow() {
			@ui.PageHeader(i18n.T(ctx, "auth.settings.title"), "") {
				@ui.LinkButton(web.MustURL(ctx, "dashboard"), ui.Secondary) {
					{ i18n.T(ctx, "auth.dashboard.title") }
				}
			}
			@ui.Card(i18n.T(ctx, "auth.settings.profile")) {
				@ui.Form(web.MustURL(ctx, "settings.profile"), "POST", nil) {
					@ui.Field("name", i18n.T(ctx, "auth.fields.name"), "") {
						@ui.Input("name", "", view.Old(ctx, "name", p.User.Name), templ.Attributes{"autocomplete": "name"})
					}
					@ui.Button(ui.Primary, nil) {
						{ i18n.T(ctx, "auth.settings.save") }
					}
				}
			}
			@ui.Card(i18n.T(ctx, "auth.fields.email")) {
				<p>
					{ p.User.Email }
					if p.User.EmailVerifiedAt == nil {
						{ " " }
						@ui.Badge(ui.Warning) {
							{ i18n.T(ctx, "auth.settings.unverified") }
						}
					}
				</p>
				if p.EmailChange {
					if p.User.PendingEmail != "" {
						<p>{ i18n.T(ctx, "auth.settings.email_pending", "email", p.User.PendingEmail) }</p>
						@ui.Form(web.MustURL(ctx, "settings.email.cancel"), "POST", nil) {
							@ui.Button(ui.Secondary, nil) {
								{ i18n.T(ctx, "auth.settings.email_cancel") }
							}
						}
					}
					@ui.Form(web.MustURL(ctx, "settings.email"), "POST", nil) {
						@ui.Field("email", i18n.T(ctx, "auth.settings.new_email"), "") {
							@ui.Input("email", "email", view.Old(ctx, "email"), templ.Attributes{"autocomplete": "email"})
						}
						@ui.Button(ui.Primary, nil) {
							{ i18n.T(ctx, "auth.settings.email_change") }
						}
					}
				}
			}
			@ui.Card(i18n.T(ctx, "auth.fields.password")) {
				@ui.Form(web.MustURL(ctx, "settings.password"), "POST", nil) {
					if p.User.Password != "" {
						@ui.Field("current_password", i18n.T(ctx, "auth.fields.current_password"), "") {
							@ui.Input("current_password", "password", "", templ.Attributes{"autocomplete": "current-password"})
						}
					} else {
						@ui.Note() {
							{ i18n.T(ctx, "auth.settings.no_password") }
						}
					}
					@ui.Field("password", i18n.T(ctx, "auth.fields.new_password"), "") {
						@ui.Input("password", "password", "", templ.Attributes{"autocomplete": "new-password"})
					}
					@ui.Field("password_confirmation", i18n.T(ctx, "auth.fields.password_confirmation"), "") {
						@ui.Input("password_confirmation", "password", "", templ.Attributes{"autocomplete": "new-password"})
					}
					@ui.Button(ui.Primary, nil) {
						{ i18n.T(ctx, "auth.settings.password_change") }
					}
				}
			}
			@ui.Card(i18n.T(ctx, "auth.settings.preferences")) {
				@ui.Form(web.MustURL(ctx, "settings.preferences"), "POST", nil) {
					@ui.Field("locale", i18n.T(ctx, "auth.settings.language"), "") {
						@ui.Select("locale", localeOptions(ctx, p.Locales), p.User.Locale, nil)
					}
					@ui.Field("time_zone", i18n.T(ctx, "auth.settings.time_zone"), "") {
						@ui.Select("time_zone", zoneOptions(ctx, p.TimeZones), p.User.TimeZone, nil)
					}
					@ui.Button(ui.Primary, nil) {
						{ i18n.T(ctx, "auth.settings.save") }
					}
				}
			}
			if p.TwoFactor {
				@ui.Card(i18n.T(ctx, "auth.two_factor.title")) {
					<p>
						if p.TwoFactorStatus.On {
							@ui.Badge(ui.Success) {
								{ i18n.T(ctx, "auth.settings.two_factor_on") }
							}
						} else {
							@ui.Badge(ui.Neutral) {
								{ i18n.T(ctx, "auth.settings.two_factor_off") }
							}
						}
					</p>
					@ui.LinkButton(web.MustURL(ctx, "two-factor"), ui.Secondary) {
						{ i18n.T(ctx, "auth.settings.two_factor_manage") }
					}
				}
			}
			if p.DeleteAccount {
				@ui.Card(i18n.T(ctx, "auth.settings.delete")) {
					@ui.Note() {
						{ i18n.T(ctx, "auth.settings.delete_intro") }
					}
					@ui.Form(web.MustURL(ctx, "settings.delete"), "POST", nil) {
						@ui.Button(ui.Danger, nil) {
							{ i18n.T(ctx, "auth.settings.delete_button") }
						}
					}
				}
			}
		}
	}
}

// RevertEmail asks the owner of an account's old address to confirm
// undoing its change to newEmail.
templ RevertEmail(token, oldEmail, newEmail string) {
	@Layout(i18n.T(ctx, "auth.revert.title")) {
		@ui.AuthCard(i18n.T(ctx, "auth.revert.title")) {
			<p>{ i18n.T(ctx, "auth.revert.intro", "old", oldEmail, "new", newEmail) }</p>
			@ui.Form(web.MustURL(ctx, "settings.email.revert"), "POST", nil) {
				<input type="hidden" name="token" value={ token }/>
				@ui.Button(ui.Danger, nil) {
					{ i18n.T(ctx, "auth.revert.submit") }
				}
			}
		}
	}
}
