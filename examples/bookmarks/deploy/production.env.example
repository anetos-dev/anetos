# The production settings of bookmarks (anetos new): copy this file
# somewhere private (not the repository), fill it in, and give it to the
# app's environment: /etc/bookmarks/env for systemd, --env-file for
# docker run, the platform's settings on a PaaS. See the "Deploy" guide.
APP_NAME=bookmarks
APP_ENV=production
APP_DEBUG=false
# The public URL, for links in emails and social sign-in callbacks.
APP_URL=https://example.com
# go tool anetos key:generate (keep it: it decrypts tokens)
APP_KEY=
APP_LOCALE=en
APP_TIMEZONE=UTC

HTTP_ADDR=:8080
# The reverse proxy or load balancer's address, so client IPs are right:
# 127.0.0.1 for a proxy on the same machine (systemd); with docker run -p,
# the Docker network's gateway (172.17.0.1); on a platform, its proxy's.
HTTP_TRUSTED_PROXIES=127.0.0.1
# The origins whose pages call the API from a browser, such as
# https://app.example.com (comma-separated); empty, none may.
HTTP_CORS_ORIGINS=

DB_CONNECTION=sqlite
# The database file is DB_DATABASE, which the Dockerfile and the systemd
# unit set, in the data directory (keep it on a volume or disk).

# Shared by every instance: database (or redis, with its driver).
CACHE_STORE=database
QUEUE_DRIVER=database

MAIL_DRIVER=smtp
MAIL_SMTP_URL=smtp://user:password@smtp.example.com:587
MAIL_FROM_ADDRESS=hello@example.com

STORAGE_DRIVER=local

# The client app's address (anetos make:auth): the verification and
# password reset emails link to its /verify-email and /reset-password
# pages, which send the token in the link to the API. Required.
AUTH_CLIENT_URL=https://app.example.com
