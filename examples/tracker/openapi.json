{
  "openapi": "3.1.0",
  "info": {
    "title": "Tracker",
    "version": "1.0.0",
    "description": "Projects and issues, for clients with an API token: create one on the tokens page."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/me": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "operationId": "api.me",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/User"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "The API token is invalid, expired or revoked. The request isn't signed in: it has no valid API token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/projects": {
      "get": {
        "tags": [
          "API"
        ],
        "operationId": "api.projects",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/APIProject"
                  }
                }
              }
            }
          },
          "401": {
            "description": "The API token is invalid, expired or revoked. The request isn't signed in: it has no valid API token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/projects/{project}/issues": {
      "get": {
        "tags": [
          "API"
        ],
        "operationId": "api.issues",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "open",
                    "closed",
                    "all"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^\\s*$"
                }
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIIssuePage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidValues"
          },
          "401": {
            "description": "The API token is invalid, expired or revoked. The request isn't signed in: it has no valid API token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/InvalidInput"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "API"
        ],
        "operationId": "api.issues.store",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/APINewIssue"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIIssue"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidValues"
          },
          "401": {
            "description": "The API token is invalid, expired or revoked. The request isn't signed in: it has no valid API token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/InvalidInput"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/projects/{project}/issues/{number}": {
      "get": {
        "tags": [
          "API"
        ],
        "operationId": "api.issues.show",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIIssue"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidValues"
          },
          "401": {
            "description": "The API token is invalid, expired or revoked. The request isn't signed in: it has no valid API token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "APIIssue": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          },
          "number": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "assignee": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "closed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "ref",
          "number",
          "title",
          "body",
          "status",
          "priority",
          "author",
          "labels",
          "created_at",
          "closed_at"
        ]
      },
      "APIIssuePage": {
        "type": "object",
        "properties": {
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/APIIssue"
            }
          },
          "page": {
            "type": "integer"
          },
          "last_page": {
            "type": "integer"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "issues",
          "page",
          "last_page",
          "total"
        ]
      },
      "APINewIssue": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "maxLength": 20000
          },
          "priority": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "low",
                  "normal",
                  "high",
                  "urgent"
                ]
              },
              {
                "type": "string",
                "pattern": "^\\s*$"
              }
            ]
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20
          }
        },
        "required": [
          "title"
        ]
      },
      "APIProject": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "archived_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "key",
          "name",
          "description",
          "archived_at"
        ]
      },
      "Problem": {
        "type": "object",
        "description": "Problem details (RFC 9457).",
        "properties": {
          "type": {
            "type": "string",
            "description": "\"about:blank\": the status says what happened."
          },
          "title": {
            "type": "string",
            "description": "The status's title, in the request's language."
          },
          "status": {
            "type": "integer",
            "description": "The HTTP status."
          },
          "detail": {
            "type": "string",
            "description": "What went wrong, for people."
          },
          "errors": {
            "type": "object",
            "description": "A message per field of the request that has a problem.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "request_id": {
            "type": "string",
            "description": "The request's ID, as in the logs."
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "email_verified_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "disabled_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "locale": {
            "type": "string"
          },
          "time_zone": {
            "type": "string"
          },
          "notify": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "created_at",
          "updated_at",
          "name",
          "email",
          "email_verified_at",
          "disabled_at",
          "locale",
          "time_zone",
          "notify"
        ]
      }
    },
    "responses": {
      "Error": {
        "description": "An error: problem details.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "InvalidInput": {
        "description": "The input isn't valid: problem details with an error per field.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "InvalidValues": {
        "description": "The request's values can't be read: problem details with an error per field.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "An API token, sent as \"Authorization: Bearer <token>\"."
      }
    }
  }
}
