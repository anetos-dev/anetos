package views

import (
	"anetos.dev/anetos/i18n"
	"anetos.dev/anetos/view"
	"anetos.dev/anetos/web"

	"anetos.dev/anetos/examples/tracker/app/models"
	"anetos.dev/anetos/examples/tracker/views/ui"
)

// IssueFormPage opens an issue, or edits one when f.Issue.ID is set.
templ IssueFormPage(f IssueForm) {
	@Layout(issueFormTitle(ctx, f)) {
		<p><a href={ web.URL(ctx, "projects.show", f.Project.Key) }>← { f.Project.Name }</a></p>
		<h1>{ issueFormTitle(ctx, f) }</h1>
		if f.Issue.ID == 0 {
			@ui.Form(web.MustURL(ctx, "issues.create", f.Project.Key), "POST", nil) {
				@issueFields(f)
			}
		} else {
			@ui.Form(web.MustURL(ctx, "issues.update", f.Project.Key, f.Issue.Number), "PUT", nil) {
				@issueFields(f)
			}
		}
	}
}

// issueFields are the fields of the issue form.
templ issueFields(f IssueForm) {
	@ui.Field("title", i18n.T(ctx, "issues.fields.title"), "") {
		@ui.Input("title", "", view.Old(ctx, "title", f.Issue.Title), templ.Attributes{"required": true, "maxlength": "200"})
	}
	@ui.Field("body", i18n.T(ctx, "issues.fields.body"), "") {
		@ui.Textarea("body", view.Old(ctx, "body", f.Issue.Body), templ.Attributes{"rows": "8"})
	}
	@ui.Row() {
		@ui.Field("priority", i18n.T(ctx, "issues.fields.priority"), "") {
			@ui.Select("priority", priorityOptions(ctx), view.Old(ctx, "priority", f.Issue.Priority), nil)
		}
		@ui.Field("assignee_id", i18n.T(ctx, "issues.fields.assignee"), "") {
			@ui.Select("assignee_id", assigneeOptions(ctx, f.Assignees), view.Old(ctx, "assignee_id", assigneeValue(f.Issue.AssigneeID)), nil)
		}
	}
	if len(f.Labels) > 0 {
		<fieldset>
			<legend>{ i18n.T(ctx, "issues.fields.labels") }</legend>
			for _, l := range f.Labels {
				@ui.CheckOption("labels", idString(l.ID), hasLabel(f.Issue, l.ID)) {
					@ui.Label(l.Name, l.Color)
				}
			}
		</fieldset>
		@ui.FieldError("labels")
	}
	@ui.Actions() {
		@ui.Button(ui.Primary, nil) {
			{ i18n.T(ctx, "issues.save") }
		}
	}
}

// IssuePageView is an issue's page.
templ IssuePageView(p IssuePage) {
	@Layout(p.Issue.Ref(p.Project.Key) + " " + p.Issue.Title) {
		<p><a href={ web.URL(ctx, "projects.show", p.Project.Key) }>← { p.Project.Name }</a></p>
		@IssueHeader(p.Project, p.Issue, p.CanEdit)
		@ui.Details() {
			@ui.Detail(i18n.T(ctx, "issues.opened_by")) {
				{ p.Issue.Author.Name }, <time datetime={ p.Issue.CreatedAt.UTC().Format("2006-01-02T15:04:05Z") }>{ i18n.DateTime(ctx, p.Issue.CreatedAt, i18n.Short) }</time>
			}
			@ui.Detail(i18n.T(ctx, "issues.fields.priority")) {
				@ui.Priority(p.Issue.Priority, i18n.T(ctx, "issues.priorities."+p.Issue.Priority))
			}
			@ui.Detail(i18n.T(ctx, "issues.fields.assignee")) {
				if p.Issue.Assignee != nil {
					{ p.Issue.Assignee.Name }
				} else {
					{ i18n.T(ctx, "issues.nobody") }
				}
			}
			if len(p.Issue.Labels) > 0 {
				@ui.Detail(i18n.T(ctx, "issues.fields.labels")) {
					for _, l := range p.Issue.Labels {
						@ui.Label(l.Name, l.Color)
					}
				}
			}
		}
		if p.CanEdit || p.CanDelete {
			@ui.Toolbar() {
				if p.CanEdit {
					<a href={ web.URL(ctx, "issues.edit", p.Project.Key, p.Issue.Number) }>{ i18n.T(ctx, "issues.edit") }</a>
				}
				if p.CanDelete {
					// To the trash: administrators can restore it in the admin.
					@ui.PostLink(web.MustURL(ctx, "issues.delete", p.Project.Key, p.Issue.Number), "DELETE", true) {
						{ i18n.T(ctx, "issues.delete") }
					}
				}
			}
		}
		if p.Issue.Body != "" {
			@ui.Body(p.Issue.Body)
		}

		<h2>{ i18n.T(ctx, "attachments.title") }</h2>
		if len(p.Attachments) == 0 {
			@ui.Note() {
				{ i18n.T(ctx, "attachments.none") }
			}
		}
		@ui.List() {
			for _, a := range p.Attachments {
				<li>
					<a href={ web.URL(ctx, "attachments.show", p.Project.Key, a.ID) }>{ a.Name }</a>
					@ui.Muted() {
						{ size(a.Size) } · { a.Uploader.Name }
					}
					if p.CanEdit {
						@ui.PostLink(web.MustURL(ctx, "attachments.delete", p.Project.Key, a.ID), "DELETE", false) {
							{ i18n.T(ctx, "attachments.delete") }
						}
					}
				</li>
			}
		}
		if p.CanAttach {
			@ui.Form(web.MustURL(ctx, "attachments.create", p.Project.Key, p.Issue.Number), "POST", templ.Attributes{"enctype": "multipart/form-data"}) {
				@ui.Row() {
					<input type="file" name="file" required aria-label={ i18n.T(ctx, "attachments.file") }/>
					@ui.Button(ui.Primary, nil) {
						{ i18n.T(ctx, "attachments.upload") }
					}
				}
				@ui.FieldError("file")
			}
		}

		<h2>{ i18n.T(ctx, "comments.title") }</h2>
		@ui.Comments("comments") {
			for _, c := range p.Comments {
				@CommentItem(c)
			}
		}
		if p.CanComment {
			// With htmx, the new comment is added to the list without a page
			// load; without, the form posts and the page reloads.
			@ui.Form(web.MustURL(ctx, "comments.create", p.Project.Key, p.Issue.Number), "POST", templ.Attributes{
				"hx-post":              web.MustURL(ctx, "comments.create", p.Project.Key, p.Issue.Number),
				"hx-target":            "#comments",
				"hx-swap":              "beforeend",
				"hx-on::after-request": "if (event.detail.successful) this.reset()",
			}) {
				@ui.Field("body", i18n.T(ctx, "comments.add"), "") {
					@ui.Textarea("body", view.Old(ctx, "body"), templ.Attributes{"rows": "4", "required": true, "maxlength": "10000"})
				}
				@ui.Button(ui.Primary, nil) {
					{ i18n.T(ctx, "comments.submit") }
				}
			}
		}

		if len(p.Activity) > 0 {
			<h2>{ i18n.T(ctx, "activity.title") }</h2>
			@ui.Activity() {
				for _, a := range p.Activity {
					<li>
						<time datetime={ a.At.UTC().Format("2006-01-02T15:04:05Z") }>{ i18n.DateTime(ctx, a.At, i18n.Short) }</time>
						{ activityText(ctx, a) }
					</li>
				}
			}
		}
	}
}

// IssueHeader is the issue's title, number and state, with the button
// that closes or reopens it: htmx swaps the header the post returns.
templ IssueHeader(project models.Project, issue models.Issue, canEdit bool) {
	@ui.TitleBar("issue-header") {
		<h1>
			{ issue.Title }{ " " }
			@ui.Key(issue.Ref(project.Key))
		</h1>
		@ui.Status(!issue.IsOpen(), i18n.T(ctx, "issues.statuses."+issue.Status))
		if canEdit {
			@ui.InlineForm(web.MustURL(ctx, "issues.status", project.Key, issue.Number), "POST", templ.Attributes{
				"hx-post":   web.MustURL(ctx, "issues.status", project.Key, issue.Number),
				"hx-target": "#issue-header",
				"hx-swap":   "outerHTML",
			}) {
				if issue.IsOpen() {
					<input type="hidden" name="status" value="closed"/>
					@ui.Button(ui.Primary, nil) {
						{ i18n.T(ctx, "issues.close") }
					}
				} else {
					<input type="hidden" name="status" value="open"/>
					@ui.Button(ui.Primary, nil) {
						{ i18n.T(ctx, "issues.reopen") }
					}
				}
			}
		}
	}
}

// CommentItem is a comment, in the list or as htmx adds it.
templ CommentItem(c models.Comment) {
	@ui.Comment("comment-"+idString(c.ID), c.Author.Name, c.Body) {
		<time datetime={ c.CreatedAt.UTC().Format("2006-01-02T15:04:05Z") }>{ i18n.Ago(ctx, c.CreatedAt) }</time>
	}
}

// AssignedList is the user's open issues, on the dashboard.
templ AssignedList(issues []AssignedIssue) {
	<h2>{ i18n.T(ctx, "dashboard.assigned") }</h2>
	if len(issues) == 0 {
		@ui.Note() {
			{ i18n.T(ctx, "dashboard.none") }
		}
	}
	@ui.List() {
		for _, a := range issues {
			<li>
				<a href={ issueURL(ctx, a.ProjectKey, a.Issue.Number) }>{ a.Issue.Title }</a>
				@ui.Key(a.Issue.Ref(a.ProjectKey))
				if a.Issue.Priority != "normal" {
					@ui.Priority(a.Issue.Priority, i18n.T(ctx, "issues.priorities."+a.Issue.Priority))
				}
			</li>
		}
	}
}
