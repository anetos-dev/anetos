package views

import (
	"anetos.dev/anetos/i18n"
	"anetos.dev/anetos/web"

	"anetos.dev/anetos/examples/tracker/views/ui"
)

// SearchPage shows the issues matching q in the user's projects.
templ SearchPage(q string, results []SearchResult) {
	@Layout(i18n.T(ctx, "search.title")) {
		<h1>{ i18n.T(ctx, "search.title") }</h1>
		@ui.Form(web.MustURL(ctx, "search"), "GET", templ.Attributes{"role": "search"}) {
			@ui.Row() {
				<input type="search" name="q" value={ q } aria-label={ i18n.T(ctx, "nav.search") } autofocus/>
				@ui.Button(ui.Primary, nil) {
					{ i18n.T(ctx, "search.submit") }
				}
			}
		}
		if q != "" && len(results) == 0 {
			<p>{ i18n.T(ctx, "search.none", "q", q) }</p>
		}
		@ui.IssueList() {
			for _, r := range results {
				@issueRow(r.Project, r.Issue)
			}
		}
	}
}
