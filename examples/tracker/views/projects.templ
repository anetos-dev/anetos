package views

import (
	"anetos.dev/anetos/i18n"
	"anetos.dev/anetos/view"
	"anetos.dev/anetos/web"

	"anetos.dev/anetos/examples/tracker/app/models"
	"anetos.dev/anetos/examples/tracker/views/ui"
)

// Projects lists the user's projects.
templ Projects(rows []ProjectRow) {
	@Layout(i18n.T(ctx, "projects.title")) {
		@ui.TitleBar("") {
			<h1>{ i18n.T(ctx, "projects.title") }</h1>
			@ui.LinkButton(web.MustURL(ctx, "projects.new"), ui.Primary) {
				{ i18n.T(ctx, "projects.new") }
			}
		}
		if len(rows) == 0 {
			<p>{ i18n.T(ctx, "projects.none") }</p>
		}
		@ui.List() {
			for _, r := range rows {
				<li>
					<a href={ web.URL(ctx, "projects.show", r.Project.Key) }><strong>{ r.Project.Name }</strong></a>
					@ui.Key(r.Project.Key)
					if r.Project.Archived() {
						@ui.Badge(ui.Neutral) {
							{ i18n.T(ctx, "projects.archived_badge") }
						}
					}
					@ui.Muted() {
						{ i18n.Plural(ctx, "projects.open_count", int(r.Open)) } · { i18n.Plural(ctx, "projects.closed_count", int(r.Done)) }
					}
				</li>
			}
		}
	}
}

// NewProject is the form for a new project.
templ NewProject() {
	@Layout(i18n.T(ctx, "projects.new")) {
		<h1>{ i18n.T(ctx, "projects.new") }</h1>
		@ui.Form(web.MustURL(ctx, "projects.create"), "POST", nil) {
			@ui.Field("name", i18n.T(ctx, "projects.fields.name"), "") {
				@ui.Input("name", "", view.Old(ctx, "name"), templ.Attributes{"required": true, "maxlength": "100"})
			}
			@ui.Field("key", i18n.T(ctx, "projects.fields.key"), "") {
				@ui.Input("key", "", view.Old(ctx, "key"), templ.Attributes{"required": true, "maxlength": "10", "pattern": "[A-Z][A-Z0-9]+", "aria-describedby": "key-help"})
				@ui.Hint("key-help", i18n.T(ctx, "projects.fields.key_help"))
			}
			@ui.Field("description", i18n.T(ctx, "projects.fields.description"), "") {
				@ui.Textarea("description", view.Old(ctx, "description"), templ.Attributes{"rows": "3"})
			}
			@ui.Actions() {
				@ui.Button(ui.Primary, nil) {
					{ i18n.T(ctx, "projects.create") }
				}
			}
		}
	}
}

// ProjectPage is a project's issues, with filters, search and pages.
templ ProjectPage(l IssueList) {
	@Layout(l.Project.Name) {
		@ui.TitleBar("") {
			<h1>
				{ l.Project.Name }{ " " }
				@ui.Key(l.Project.Key)
			</h1>
			if l.CanCreate {
				@ui.LinkButton(web.MustURL(ctx, "issues.new", l.Project.Key), ui.Primary) {
					{ i18n.T(ctx, "issues.new") }
				}
			}
			if l.CanManage {
				<a href={ web.URL(ctx, "projects.settings", l.Project.Key) }>{ i18n.T(ctx, "projects.settings") }</a>
			}
		}
		if l.Project.Archived() {
			@ui.Notice() {
				{ i18n.T(ctx, "projects.archived") }
			}
		}
		if l.Project.Description != "" {
			<p>{ l.Project.Description }</p>
		}
		@ui.Tabs() {
			for _, s := range []string{"open", "closed", "all"} {
				@ui.Tab(filterURL(ctx, l.Project, l.Filter, "status", s), i18n.T(ctx, "issues.status_tabs."+s), l.Filter.Status == s)
			}
		}
		@ui.Filters(web.MustURL(ctx, "projects.show", l.Project.Key)) {
			<input type="hidden" name="status" value={ l.Filter.Status }/>
			<input type="search" name="q" value={ l.Filter.Q } placeholder={ i18n.T(ctx, "issues.search") } aria-label={ i18n.T(ctx, "issues.search") }/>
			<select name="label" aria-label={ i18n.T(ctx, "issues.fields.labels") }>
				<option value="">{ i18n.T(ctx, "issues.any_label") }</option>
				for _, lb := range l.Labels {
					<option value={ lb.Name } selected?={ lb.Name == l.Filter.Label }>{ lb.Name }</option>
				}
			</select>
			<select name="assignee" aria-label={ i18n.T(ctx, "issues.fields.assignee") }>
				<option value="">{ i18n.T(ctx, "issues.anyone") }</option>
				<option value="me" selected?={ l.Filter.Assignee == "me" }>{ i18n.T(ctx, "issues.me") }</option>
				<option value="none" selected?={ l.Filter.Assignee == "none" }>{ i18n.T(ctx, "issues.nobody") }</option>
				for _, u := range l.Assignees {
					<option value={ idString(u.ID) } selected?={ idString(u.ID) == l.Filter.Assignee }>{ u.Name }</option>
				}
			</select>
			<select name="sort" aria-label={ i18n.T(ctx, "issues.sort") }>
				for _, s := range []string{"newest", "oldest", "updated", "priority"} {
					<option value={ s } selected?={ s == l.Filter.Sort || s == "newest" && l.Filter.Sort == "" }>{ i18n.T(ctx, "issues.sorts." + s) }</option>
				}
			</select>
			@ui.Button(ui.Primary, nil) {
				{ i18n.T(ctx, "issues.filter") }
			}
		}
		if l.Page.Total == 0 {
			<p>{ i18n.T(ctx, "issues.none") }</p>
		}
		@ui.IssueList() {
			for _, issue := range l.Page.Data {
				@issueRow(l.Project, issue)
			}
		}
		@ui.Pagination(issuePages(ctx, l.Page))
	}
}

// issueRow is an issue in a list.
templ issueRow(project models.Project, issue models.Issue) {
	<li>
		@ui.Status(!issue.IsOpen(), i18n.T(ctx, "issues.statuses."+issue.Status))
		<a href={ issueURL(ctx, project.Key, issue.Number) }>{ issue.Title }</a>
		@ui.Key(issue.Ref(project.Key))
		for _, lb := range issue.Labels {
			@ui.Label(lb.Name, lb.Color)
		}
		@ui.Meta() {
			if issue.Priority != "normal" {
				@ui.Priority(issue.Priority, i18n.T(ctx, "issues.priorities."+issue.Priority))
			}
			if issue.Assignee != nil {
				{ issue.Assignee.Name }
			}
			<time datetime={ issue.CreatedAt.UTC().Format("2006-01-02T15:04:05Z") }>{ i18n.Ago(ctx, issue.CreatedAt) }</time>
		}
	</li>
}

// ProjectSettingsPage is a project's settings: its name, labels, members,
// and archiving.
templ ProjectSettingsPage(p ProjectSettings) {
	@Layout(i18n.T(ctx, "projects.settings")) {
		<p><a href={ web.URL(ctx, "projects.show", p.Project.Key) }>← { p.Project.Name }</a></p>
		<h1>{ i18n.T(ctx, "projects.settings") }</h1>
		@ui.Form(web.MustURL(ctx, "projects.update", p.Project.Key), "PUT", nil) {
			@ui.Field("name", i18n.T(ctx, "projects.fields.name"), "") {
				@ui.Input("name", "", view.Old(ctx, "name", p.Project.Name), templ.Attributes{"required": true, "maxlength": "100"})
			}
			@ui.Field("description", i18n.T(ctx, "projects.fields.description"), "") {
				@ui.Textarea("description", view.Old(ctx, "description", p.Project.Description), templ.Attributes{"rows": "3"})
			}
			@ui.Button(ui.Primary, nil) {
				{ i18n.T(ctx, "projects.save") }
			}
		}
		<h2>{ i18n.T(ctx, "members.title") }</h2>
		@ui.FieldError("role")
		@ui.Table() {
			<tbody>
				for _, m := range p.Members {
					<tr>
						<td>
							{ m.User.Name }{ " " }
							@ui.Muted() {
								{ m.User.Email }
							}
						</td>
						if p.Project.Archived() {
							<td>{ i18n.T(ctx, "members.roles." + m.Role) }</td>
						} else {
							<td>
								@ui.InlineForm(web.MustURL(ctx, "members.update", p.Project.Key, m.User.ID), "PUT", nil) {
									<select name="role" aria-label={ i18n.T(ctx, "members.role") }>
										for _, r := range p.Roles {
											<option value={ r } selected?={ r == m.Role }>{ i18n.T(ctx, "members.roles." + r) }</option>
										}
									</select>
									@ui.Button(ui.Primary, nil) {
										{ i18n.T(ctx, "members.change") }
									}
								}
							</td>
							@ui.ActionsCell() {
								@ui.PostLink(web.MustURL(ctx, "members.delete", p.Project.Key, m.User.ID), "DELETE", false) {
									if m.User.ID == p.MeID {
										{ i18n.T(ctx, "members.leave") }
									} else {
										{ i18n.T(ctx, "members.remove") }
									}
								}
							}
						}
					</tr>
				}
			</tbody>
		}
		if !p.Project.Archived() {
			@ui.Form(web.MustURL(ctx, "members.create", p.Project.Key), "POST", nil) {
				@ui.Field("email", i18n.T(ctx, "members.add"), "") {
					@ui.Row() {
						@ui.Input("email", "email", view.Old(ctx, "email"), templ.Attributes{"required": true, "placeholder": "name@example.com"})
						<select name="role" aria-label={ i18n.T(ctx, "members.role") }>
							for _, r := range p.Roles {
								<option value={ r } selected?={ r == "member" }>{ i18n.T(ctx, "members.roles." + r) }</option>
							}
						</select>
						@ui.Button(ui.Primary, nil) {
							{ i18n.T(ctx, "members.add_button") }
						}
					}
				}
			}
		}
		<h2>{ i18n.T(ctx, "labels.title") }</h2>
		@ui.List() {
			for _, l := range p.Labels {
				<li>
					@ui.Label(l.Name, l.Color)
					if !p.Project.Archived() {
						@ui.PostLink(web.MustURL(ctx, "labels.delete", p.Project.Key, l.ID), "DELETE", false) {
							{ i18n.T(ctx, "labels.delete") }
						}
					}
				</li>
			}
		}
		if !p.Project.Archived() {
			@ui.Form(web.MustURL(ctx, "labels.create", p.Project.Key), "POST", nil) {
				@ui.Field("label", i18n.T(ctx, "labels.add"), "") {
					@ui.Row() {
						@ui.Input("label", "", view.Old(ctx, "label"), templ.Attributes{"required": true, "maxlength": "50"})
						<input type="color" name="color" value={ view.Old(ctx, "color", "#6b7280") } aria-label={ i18n.T(ctx, "labels.color") }/>
						@ui.Button(ui.Primary, nil) {
							{ i18n.T(ctx, "labels.add_button") }
						}
					}
				}
				@ui.FieldError("color")
			}
		}
		<h2>{ i18n.T(ctx, "projects.archive_title") }</h2>
		@ui.Form(web.MustURL(ctx, "projects.archive", p.Project.Key), "POST", nil) {
			if p.Project.Archived() {
				<p>{ i18n.T(ctx, "projects.archived") }</p>
				@ui.Button(ui.Primary, nil) {
					{ i18n.T(ctx, "projects.unarchive") }
				}
			} else {
				<p>{ i18n.T(ctx, "projects.archive_intro") }</p>
				@ui.Button(ui.Primary, nil) {
					{ i18n.T(ctx, "projects.archive") }
				}
			}
		}
	}
}
