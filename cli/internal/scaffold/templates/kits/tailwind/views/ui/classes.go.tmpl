package ui

import "strings"

// The components' Tailwind classes for the looks and tones. Tailwind finds the
// classes it generates in the files of views/, these strings among them:
// keep each class whole (no "bg-" + color), or it won't be in app.css.

// class is a button's classes.
func (l Look) class() string {
	c := []string{"inline-flex cursor-pointer items-center justify-center gap-2 rounded-lg font-medium transition-colors hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-not-allowed disabled:opacity-50"}
	kind := l &^ (Small | Full)
	switch {
	case kind == Ghost:
		c = append(c, "p-0 text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100")
	case l&Small != 0:
		c = append(c, "px-2.5 py-1 text-xs")
	default:
		c = append(c, "px-4 py-2 text-sm")
	}
	switch kind {
	case Secondary:
		c = append(c, "border border-zinc-300 bg-white text-zinc-800 shadow-xs hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:hover:bg-zinc-800")
	case Danger:
		c = append(c, "bg-red-600 text-white shadow-xs hover:bg-red-700")
	case Ghost:
	default:
		c = append(c, "bg-accent text-on-accent shadow-xs hover:bg-accent-hover")
	}
	if l&Full != 0 {
		c = append(c, "w-full")
	}
	return strings.Join(c, " ")
}

// badge is a badge's classes in a tone's colors.
func (t Tone) badge() string {
	switch t {
	case Success:
		return "bg-green-100 text-green-800 dark:bg-green-900/50 dark:text-green-300"
	case Warning:
		return "bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-300"
	case Error:
		return "bg-red-100 text-red-800 dark:bg-red-900/50 dark:text-red-300"
	case Info:
		return "bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-300"
	}
	return "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300"
}

// flash is a message's classes in a tone's colors.
func (t Tone) flash() string {
	switch t {
	case Success:
		return "border-green-200 bg-green-50 text-green-900 dark:border-green-900 dark:bg-green-950 dark:text-green-200"
	case Warning:
		return "border-amber-200 bg-amber-50 text-amber-900 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-200"
	case Error:
		return "border-red-200 bg-red-50 text-red-900 dark:border-red-900 dark:bg-red-950 dark:text-red-200"
	case Info:
		return "border-blue-200 bg-blue-50 text-blue-900 dark:border-blue-900 dark:bg-blue-950 dark:text-blue-200"
	}
	return "border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900"
}

// control is the classes of an input, a textarea and a select; invalid
// ones (aria-invalid) get a red border.
const control = "block w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 shadow-xs placeholder:text-zinc-500 focus:border-accent focus:outline-2 focus:outline-accent/50 aria-invalid:border-red-500 aria-invalid:focus:outline-red-500/30 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100"
