package ui

// The structure of a page's content.

// PageHeader is a page's title, with a line under it when lead isn't "",
// and its actions (children, such as a LinkButton) at the end.
templ PageHeader(title, lead string) {
	<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
		<div>
			<h1 class="m-0">{ title }</h1>
			if lead != "" {
				<p class="mt-1 mb-0 text-zinc-600 dark:text-zinc-400">{ lead }</p>
			}
		</div>
		{ children... }
	</div>
}

// Narrow keeps its children to a readable width, for forms and text.
templ Narrow() {
	<div class="max-w-2xl">
		{ children... }
	</div>
}

// Stack puts its children one under the other, spaced evenly.
templ Stack() {
	<div class="flex flex-col gap-4 [&>*]:m-0">
		{ children... }
	</div>
}

// Cluster puts its children side by side, wrapping: buttons, a search
// field and its button.
templ Cluster() {
	<div class="flex flex-wrap items-center gap-2 [&_input:not([type=hidden])]:w-auto [&_input:not([type=hidden])]:flex-1">
		{ children... }
	</div>
}

// Card is a box of related content, under a heading when title isn't "".
templ Card(title string) {
	<section class="mb-6 rounded-xl border border-zinc-200 bg-white p-5 shadow-xs dark:border-zinc-800 dark:bg-zinc-900">
		if title != "" {
			<h2 class="mb-4">{ title }</h2>
		}
		{ children... }
	</section>
}

// CardHeader is a card's heading with actions (children) beside it, for
// a Card("").
templ CardHeader(title string) {
	<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
		<h2>{ title }</h2>
		{ children... }
	</div>
}

// AuthCard is a page made of one small card under its title, as the
// login pages are.
templ AuthCard(title string) {
	<div class="mx-auto my-6 max-w-sm rounded-xl border border-zinc-200 bg-white p-6 shadow-xs dark:border-zinc-800 dark:bg-zinc-900">
		<h1 class="mb-5 text-xl">{ title }</h1>
		{ children... }
	</div>
}

// Empty says a list has nothing in it yet.
templ Empty(text string) {
	<p class="rounded-xl border border-dashed border-zinc-300 px-4 py-10 text-center text-zinc-500 dark:border-zinc-700 dark:text-zinc-400">{ text }</p>
}

// Note is a paragraph of secondary text.
templ Note() {
	<p class="text-sm text-zinc-500 dark:text-zinc-400">
		{ children... }
	</p>
}

// SROnly is text for screen readers only, such as a column's heading
// that a sighted reader doesn't need.
templ SROnly(text string) {
	<span class="sr-only">{ text }</span>
}
