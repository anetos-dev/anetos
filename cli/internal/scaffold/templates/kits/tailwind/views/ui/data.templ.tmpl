package ui

// Lists, tables and values.

// Table is a table in a box that scrolls sideways when it's too wide;
// its children are the <thead> and <tbody>.
templ Table() {
	<div class="mb-4 overflow-x-auto rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900">
		<table class="w-full text-sm">
			{ children... }
		</table>
	</div>
}

// ActionsCell is a row's cell of buttons, at its end.
templ ActionsCell() {
	<td class="whitespace-nowrap text-end [&>*+*]:ms-2">
		{ children... }
	</td>
}

// Details is a list of terms and their values (Detail).
templ Details() {
	<dl class="m-0 grid gap-x-6 gap-y-1 sm:grid-cols-[minmax(8rem,max-content)_1fr] sm:gap-y-2">
		{ children... }
	</dl>
}

// Detail is a term and its value (children).
templ Detail(term string) {
	<dt class="text-sm font-medium text-zinc-500 dark:text-zinc-400">{ term }</dt>
	<dd class="m-0 mb-2 min-w-0 break-words sm:mb-0">
		{ children... }
	</dd>
}

// Multiline is text of several lines, shown with its line breaks.
templ Multiline(text string) {
	<span class="whitespace-pre-wrap">{ text }</span>
}

// Badge is a short label in a tone's color: a status, a count.
templ Badge(tone Tone) {
	<span class={ "inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium " + tone.badge() }>
		{ children... }
	</span>
}

// Pagination links to the pages before and after a list's page.
templ Pagination(p Pages) {
	<nav class="mt-6 flex items-center justify-center gap-4 text-sm" aria-label={ p.Label }>
		if p.Prev != "" {
			<a href={ p.Prev } rel="prev">{ p.PrevLabel }</a>
		}
		if p.Status != "" {
			<span class="text-zinc-500 dark:text-zinc-400">{ p.Status }</span>
		}
		if p.Next != "" {
			<a href={ p.Next } rel="next">{ p.NextLabel }</a>
		}
	</nav>
}
