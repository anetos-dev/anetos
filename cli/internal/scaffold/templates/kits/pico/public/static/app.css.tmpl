/*
 * The app's styles, after Pico's (pico.min.css, v[[.KitVersion]]): yours to
 * change. Pico styles plain HTML; the components of views/ui add the few
 * classes below for what it has no style of (the header's layout, a
 * danger, ghost or small button, badges, colored messages). Light and
 * dark follow the system, or data-theme="dark" (or "light") on <html>.
 */

:root {
	--danger: #c62828;
	--danger-hover: #a31f1f;
	--success: #2e8b57;
	--warning: #c27c0e;
	--info: #1e74c6;
}

/* The header: the app's name, its links and the account's, wrapping on a
   small screen. */
.topbar { display: flex; flex-wrap: wrap; align-items: center; gap: .25rem 1.5rem; }
.brand { font-weight: 700; color: var(--pico-color); text-decoration: none; }
.topbar nav ul { flex-wrap: wrap; }
.nav-end { margin-left: auto; }
.nav-end ul { display: flex; flex-wrap: wrap; align-items: center; margin: 0 calc(var(--pico-nav-element-spacing-horizontal) * -1); padding: 0; list-style: none; }
.nav-end li { display: inline-block; list-style: none; margin: 0; padding: var(--pico-nav-element-spacing-vertical) var(--pico-nav-element-spacing-horizontal); }
.nav-end li a:not([role=button]) { text-decoration: none; }
.topbar a[aria-current="page"] { color: var(--pico-primary); font-weight: 600; }
.topbar :is(button, [role=button], form) { margin: 0; }
.topbar .ghost { padding-inline: 0; }
.site-footer { color: var(--pico-muted-color); font-size: .875rem; border-top: 1px solid var(--pico-muted-border-color); }

/* A message, a badge: a tone's color. */
.flash { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1rem; padding: .75rem 1rem; border-left: .25rem solid var(--tone, var(--pico-muted-border-color)); }
.flash > * { margin: 0; }
.badge { display: inline-block; padding: .1rem .5rem; border-radius: 1rem; font-size: .8rem; font-weight: 600; white-space: nowrap; background: color-mix(in srgb, var(--tone, var(--pico-muted-color)) 22%, transparent); }
:is(.flash, .badge).success { --tone: var(--success); }
:is(.flash, .badge).warning { --tone: var(--warning); }
:is(.flash, .badge).danger { --tone: var(--danger); }
:is(.flash, .badge).info { --tone: var(--info); }

/* The page's structure. */
.page-header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: var(--pico-spacing); }
.page-header hgroup { margin: 0; }
.page-header h1 { font-size: 1.75rem; }
.page-header > :not(hgroup) { margin-bottom: 0; }
.narrow { max-width: 42rem; }
.stack { display: flex; flex-direction: column; gap: var(--pico-spacing); }
.cluster { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; }
.cluster > *, .cluster input { margin-bottom: 0; }
.cluster input:not([type=hidden], [type=checkbox], [type=radio]) { width: auto; flex: 1 1 12rem; }
.card > header h2, .card > header h1 { margin: 0; font-size: 1.25rem; }
.card-header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem 1rem; }
.auth-card { max-width: 26rem; margin: 1rem auto; }
.auth-card > header h1 { font-size: 1.5rem; }
.muted { color: var(--pico-muted-color); }
.empty { padding: 2rem 1rem; text-align: center; color: var(--pico-muted-color); border: 1px dashed var(--pico-muted-border-color); border-radius: var(--pico-border-radius); }
.prewrap { white-space: pre-wrap; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

/* Forms: a field's message and hint under its control. */
.field > small { display: block; }
.field > small + small { margin-top: calc(var(--pico-spacing) * -.75); }
.field > .check { margin-bottom: var(--pico-spacing); }
.field > .check + small { margin-top: calc(var(--pico-spacing) * -.5); margin-bottom: var(--pico-spacing); }
.error { color: var(--pico-del-color); }
.inline { display: inline-flex; align-items: center; gap: .5rem; margin: 0; }
.inline :is(input, select, button) { margin-bottom: 0; }
.inline input:not([type=hidden], [type=checkbox], [type=radio]) { width: auto; }
.form-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: calc(var(--pico-spacing) * .5); }
.form-actions > * { margin-bottom: 0; }

/* Buttons: Pico's primary (no class) and .secondary; these add the
   others. A submit button is as wide as its text, unless .full. */
button[type=submit]:not(.full) { width: auto; }
:is(button, [role=button]).full { width: 100%; }
:is(button, [role=button]).small { --pico-form-element-spacing-vertical: .3rem; --pico-form-element-spacing-horizontal: .7rem; font-size: .875rem; }
:is(button, [role=button]).danger { --pico-background-color: var(--danger); --pico-border-color: var(--danger); --pico-color: #fff; }
:is(button, [role=button]).danger:is(:hover, :active, :focus) { --pico-background-color: var(--danger-hover); --pico-border-color: var(--danger-hover); --pico-color: #fff; }
:is(button, [role=button]).ghost { --pico-background-color: transparent; --pico-border-color: transparent; --pico-color: var(--pico-primary); --pico-box-shadow: none; }
:is(button, [role=button]).ghost:is(:hover, :active, :focus) { --pico-background-color: transparent; --pico-border-color: transparent; --pico-color: var(--pico-primary-hover); text-decoration: underline; }

/* Lists and tables. */
td.actions { text-align: right; white-space: nowrap; }
td.actions > * + * { margin-left: .5rem; }
.details { display: grid; grid-template-columns: minmax(8rem, max-content) 1fr; gap: .6rem 1.5rem; margin: 0; }
.details dt { color: var(--pico-muted-color); font-weight: 600; }
.details dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
@media (max-width: 40rem) {
	.details { grid-template-columns: 1fr; gap: .15rem; }
	.details dd { margin-bottom: .6rem; }
}
.pagination { justify-content: center; }
