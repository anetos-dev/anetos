package ui

import (
	"slices"
	"strings"
)

// Pico's classes of the variants and sizes, and app.css's of the tones (Pico has no
// danger, ghost, small or full button, badge or colored message: app.css
// adds them).

// class is a button's classes: "" for the primary one, which Pico styles
// without any.
func (v Variant) class(sizes []Size) string {
	var c []string
	switch v {
	case Secondary:
		c = append(c, "secondary")
	case Danger:
		c = append(c, "danger")
	case Ghost:
		c = append(c, "ghost")
	}
	if has(sizes, Small) {
		c = append(c, "small")
	}
	if has(sizes, FullWidth) {
		c = append(c, "full")
	}
	return strings.Join(c, " ")
}

// toneClass is the class of a tone added to a badge's or a message's.
func (t Tone) toneClass() string {
	switch t {
	case Success:
		return " success"
	case Warning:
		return " warning"
	case Error:
		return " danger"
	case Info:
		return " info"
	}
	return ""
}

// has reports whether sizes has s.
func has(sizes []Size, s Size) bool { return slices.Contains(sizes, s) }
