package ui

// The structure of a page's content.

// PageHeader is a page's title, with a line under it when lead isn't "",
// and its actions (children, such as a LinkButton) at the end.
templ PageHeader(title, lead string) {
	<div>
		<div>
			<h1>{ title }</h1>
			if lead != "" {
				<p>{ lead }</p>
			}
		</div>
		{ children... }
	</div>
}

// Narrow keeps its children to a readable width, for forms and text.
templ Narrow() {
	<div>
		{ children... }
	</div>
}

// Stack puts its children one under the other, spaced evenly.
templ Stack() {
	<div>
		{ children... }
	</div>
}

// Cluster puts its children side by side, wrapping: buttons, a search
// field and its button.
templ Cluster() {
	<div>
		{ children... }
	</div>
}

// Card is a box of related content, under a heading when title isn't "".
templ Card(title string) {
	<section>
		if title != "" {
			<h2>{ title }</h2>
		}
		{ children... }
	</section>
}

// CardHeader is a card's heading with actions (children) beside it, for
// a Card("").
templ CardHeader(title string) {
	<div>
		<h2>{ title }</h2>
		{ children... }
	</div>
}

// AuthCard is a page made of one small card under its title, as the
// login pages are.
templ AuthCard(title string) {
	<section>
		<h1>{ title }</h1>
		{ children... }
	</section>
}

// Empty says a list has nothing in it yet.
templ Empty(text string) {
	<p>{ text }</p>
}

// Note is a paragraph of secondary text.
templ Note() {
	<p>
		{ children... }
	</p>
}

// SROnly is text for screen readers only, such as a column's heading
// that a sighted reader doesn't need.
templ SROnly(text string) {
	<span style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap">{ text }</span>
}
