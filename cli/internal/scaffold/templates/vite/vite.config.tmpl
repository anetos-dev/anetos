import { defineConfig } from 'vite'

// The frontend of [[.Title]]. `vite build` writes it into public/build,
// which the app embeds and serves under /build/, with the manifest
// (build/manifest.json) that @vite.Tags reads in views/layout.templ.
// anetos dev runs Vite's development server (on a port of its own) and
// forwards /build/ to it.

// Go's //go:embed leaves out files whose names start with _ or .: the
// build's files are named without them.
const embeddable = (name[[if .TS]]: string[[end]]) => name.replace(/^[_.]+/, '')

export default defineConfig({
  base: '/build/',
  build: {
    outDir: '../public/build',
    emptyOutDir: true,
    manifest: 'manifest.json',
    rolldownOptions: {
      // The entries, which @vite.Tags names.
      input: ['src/main.[[.Ext]]'],
      output: {
        entryFileNames: (chunk) => `assets/${embeddable(chunk.name)}-[hash].js`,
        chunkFileNames: (chunk) => `assets/${embeddable(chunk.name)}-[hash].js`,
        assetFileNames: (asset) => `assets/${embeddable(asset.names[0] ?? 'asset').replace(/\.[^.]*$/, '')}-[hash][extname]`,
      },
    },
  },
})
