APP_NAME=[[.Name]]
APP_ENV=development
APP_DEBUG=true
# The public URL, for links that leave the app (OAuth callbacks, emails)
APP_URL=http://localhost:8080
# go tool anetos key:generate
APP_KEY=

HTTP_ADDR=:8080

# memory (default) or database
CACHE_STORE=memory
# cookie (default) or database
SESSION_DRIVER=cookie
# sync (default: jobs run when dispatched), memory or database
QUEUE_DRIVER=database

# log (default: emails are written to the log) or smtp (MAIL_SMTP_URL)
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=hello@example.com
# MAIL_SMTP_URL=smtp://127.0.0.1:1025
[[template "db-env" .]]
