import { Head, usePage } from '@inertiajs/react'
import { Card, PageHeader } from '../components/ui'
import { useT } from '../i18n'
import type { PageProps } from '../types/pages'

// Home is the home page (handlers.Home). Its text is in
// locales/en/app.yaml, under home.
export default function Home(_: PageProps<'Home'>) {
  const t = useT()
  const { appName } = usePage().props
  return (
    <>
      <Head title={t('home.title')} />
      <PageHeader title={t('home.welcome', { app: appName })} lead={t('home.edit')} />
      <Card title={t('home.next')}>
        <ul>
          <li>
            <code>go tool anetos make:crud Post title:string body:text</code> {t('home.crud')}
          </li>
          <li>
            <code>go tool anetos make:auth</code> {t('home.auth')}
          </li>
          <li>
            <code>go run . migrate</code> {t('home.migrate')}
          </li>
        </ul>
      </Card>
    </>
  )
}
