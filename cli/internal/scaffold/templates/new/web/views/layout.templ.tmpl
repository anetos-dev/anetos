package views

import (
	"strings"

	"anetos.dev/anetos/i18n"
	"anetos.dev/anetos/view"
	"anetos.dev/anetos/web"

	"[[.Module]]/public"
	"[[.Module]]/views/ui"
)

// Layout is the page shell: the header with the app's links, the flash
// message, then the page, which passes its content as children. Its
// markup is views/ui's components, styled by public/static/app.css.
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang={ i18n.Locale(ctx) } dir={ i18n.Dir(ctx) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · [[.Title]]</title>
			for _, a := range web.Alternates(ctx) {
				<link rel="alternate" hreflang={ a.Locale } href={ a.URL }/>
			}
			<link rel="icon" href={ public.Assets.URL("favicon.svg") } type="image/svg+xml"/>
			@ui.Head()
			<script src={ public.Assets.URL("htmx.min.js") } defer></script>
		</head>
		<body hx-headers={ `{"X-CSRF-Token": "` + view.CSRFToken(ctx) + `"}` }>
			@ui.Header("[[.Title]]", web.MustURL(ctx, "home")) {
				@ui.Nav(i18n.T(ctx, "nav.label")) {
					@navLink("home", i18n.T(ctx, "nav.home"))
				}
			}
			@ui.Main() {
				if msg := view.Flash(ctx, "status"); msg != "" {
					@ui.Flash(ui.Success) {
						{ msg }
					}
				}
				{ children... }
			}
			@ui.Footer() {
				<p>[[.Title]]</p>
			}
		</body>
	</html>
}

// navLink links to the named route, marked as the current page when the
// request is for a route of its group: for posts.index, the routes named
// posts.something (posts.show, posts.edit…).
templ navLink(route, label string) {
	@ui.NavLink(web.MustURL(ctx, route), label, web.RouteIs(ctx, route, strings.TrimSuffix(route, ".index")+".*"))
}
