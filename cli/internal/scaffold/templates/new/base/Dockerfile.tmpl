# The app's image (anetos new): one static binary on a distroless base,
# run as a user without privileges. See the "Deploy" guide.
#
#   docker build -t [[.Image]] --build-arg VERSION=v1.0.0 .[[if ne .DB "sqlite"]]
#   docker run --rm --env-file production.env [[.Image]] migrate[[end]]
#   docker run -d -p 8080:8080 --env-file production.env -v [[.Image]]-data:/data [[.Image]]
#[[if eq .DB "sqlite"]]
# It migrates the SQLite database in /data when it starts
# (DB_MIGRATE_ON_START); the server is ready once that's done.
#[[else]]
# The server reports itself unavailable (health:check) while migrations
# haven't run.
#[[end]]
# The settings come from the environment (production.env: see
# deploy/production.env.example); .env isn't in the image. RUN --mount
# needs BuildKit, Docker's builder since version 23.

FROM golang:[[.GoMinor]] AS build
WORKDIR /src
# The dependencies first: in BuildKit's cache, kept between builds on
# the same machine.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
# The version the app's version command prints (the image has no git history).
ARG VERSION=""[[if eq .Kit "tailwind"]]
# anetos build compiles the stylesheet with Tailwind CSS, downloaded once
# into BuildKit's cache (/root/.cache/anetos).
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build --mount=type=cache,target=/root/.cache/anetos \
    go tool anetos build -o /out/[[.Name]] --version="$VERSION" && mkdir -p /out/data[[else]]
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go tool anetos build -o /out/[[.Name]] --version="$VERSION" && mkdir -p /out/data[[end]]

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/[[.Name]] /app/[[.Name]]
# /data holds the files of STORAGE_DRIVER=local[[if eq .DB "sqlite"]] and the SQLite database[[end]]:
# mount a volume there.
COPY --from=build --chown=65532:65532 /out/data /data
ENV APP_ENV=production \
    STORAGE_ROOT=/data/storage[[if eq .DB "sqlite"]] \
    DB_NAME=/data/app.db \
    DB_MIGRATE_ON_START=true[[end]]
EXPOSE 8080
USER 65532:65532
# The server's readiness; turn it off for containers that don't serve
# HTTP (run --only=worker).
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s CMD ["/app/[[.Name]]", "health:check"]
ENTRYPOINT ["/app/[[.Name]]"]
# Every component; run --only=web, worker, scheduler or listener for one process type.
CMD ["run"]
