# The production settings of [[.Name]] (anetos new): copy this file
# somewhere private (not the repository), fill it in, and give it to the
# app's environment: /etc/[[.Name]]/env for systemd, --env-file for
# docker run, the platform's settings on a PaaS. See the "Deploy" guide.
APP_NAME=[[.Name]]
APP_ENV=production
APP_DEBUG=false
# The public URL, for links in emails and social sign-in callbacks.
APP_URL=https://example.com
# go tool anetos key:generate (keep it: it decrypts [[if .Web]]sessions and [[end]]tokens)
APP_KEY=
APP_LOCALE=en
APP_TIMEZONE=UTC

# HTTP_ADDR=:8080 (the default; unset, a hosting platform's PORT is used)
# The reverse proxy or load balancer's address, so client IPs are right:
# 127.0.0.1 for a proxy on the same machine (systemd); with docker run -p,
# the Docker network's gateway (172.17.0.1); on a platform, its proxy's.
HTTP_TRUSTED_PROXIES=127.0.0.1
[[- if .API]]
# The origins whose pages call the API from a browser, such as
# https://app.example.com (comma-separated); empty, none may.
HTTP_CORS_ORIGINS=
[[- end]]

[[template "db-env-prod" .]]

# Shared by every instance: database (or redis, with its driver).
CACHE_DRIVER=database
[[- if .Web]]
SESSION_DRIVER=database
[[- end]]
QUEUE_DRIVER=database

MAIL_DRIVER=smtp
MAIL_SMTP_URL=smtp://user:password@smtp.example.com:587
MAIL_FROM_ADDRESS=hello@example.com

STORAGE_DRIVER=local
