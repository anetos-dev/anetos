# Settings for `go test` (anetostest), which doesn't read .env; the
# environment overrides them. Create the database first.
[[- if eq .DB "postgres"]]
DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=[[.DBName]]_test
DB_USERNAME=postgres
DB_PASSWORD=
[[- else]]
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=[[.DBName]]_test
DB_USERNAME=root
DB_PASSWORD=
[[- end]]
