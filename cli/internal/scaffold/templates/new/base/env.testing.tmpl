# Settings for `go test` (anetostest), which doesn't read .env; the
# environment overrides them. Create the database first.
[[- if eq .DB "postgres"]]
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=[[.DBName]]_test
DB_USER=postgres
DB_PASSWORD=
[[- else]]
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=[[.DBName]]_test
DB_USER=root
DB_PASSWORD=
[[- end]]
