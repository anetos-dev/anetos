package views

import "anetos.dev/anetos/i18n"

// Home is the home page. Its text is in locales/en/app.yaml.
templ Home() {
	@Layout(i18n.T(ctx, "home.title")) {
		<h1>{ i18n.T(ctx, "home.welcome", "app", "[[.Title]]") }</h1>
		<p>{ i18n.T(ctx, "home.edit") }</p>
		<ul>
			<li><code>go tool anetos make:model Post --migration</code> { i18n.T(ctx, "home.model") }</li>
			<li><code>go tool anetos make:handler Posts</code> { i18n.T(ctx, "home.handler") }</li>
			<li><code>go run . migrate</code> { i18n.T(ctx, "home.migrate") }</li>
		</ul>
	}
}
