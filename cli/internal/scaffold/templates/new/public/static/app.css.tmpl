body { font-family: system-ui, sans-serif; max-width: 48rem; margin: 2rem auto; padding: 0 1rem; line-height: 1.5; color: #1d1d1f; }
header { display: flex; gap: 1rem; align-items: baseline; border-bottom: 1px solid #ddd; padding-bottom: .5rem; margin-bottom: 1.5rem; }
header a { font-weight: 700; text-decoration: none; color: inherit; }
.flash { background: #e6f4ea; border: 1px solid #a8d5b5; padding: .5rem .75rem; border-radius: 4px; }
.error { color: #b00020; }
code { background: #f2f2f4; padding: .1rem .3rem; border-radius: 3px; }
