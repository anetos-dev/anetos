package handlers

import (
[[- if .Inertia]]
	"time"
[[- else]]
	"net/http"
[[- end]]
[[if .HasDate]]
	"anetos.dev/anetos"
[[- end]]
	"anetos.dev/anetos/db"
	"anetos.dev/anetos/i18n"
	"anetos.dev/anetos/web"

	"[[.Module]]/app/models"
[[- if not .Inertia]]
	"[[.Module]]/views"
[[- end]]
)

// [[.Plural]] serves the [[.PluralW]] pages (anetos make:crud): the list, a
// [[.Words]]'s page, and the forms to create, edit and delete one. Yours to
// change; routes/[[.Table]].go routes them.
type [[.Plural]] struct{}

// [[.Model]]List is the input of the list: the page number, from ?page=.
type [[.Model]]List struct {
	Page int `query:"page"`
}

// [[.Model]]ID reads {id} from the path.
type [[.Model]]ID struct {
	ID int64 `path:"id"`
}

// [[.Model]]Input is the [[.Words]] form. Its validate tags are checked before
// the handler runs: an invalid form goes back with its errors and what
// was typed.
type [[.Model]]Input struct {
	ID int64 `path:"id"` // when editing
[[- range .Fields]]
	[[.Go]] [[.GoType]] `json:"[[.Name]]"[[with .Rules $.Table]] validate:"[[.]]"[[end]]`
[[- end]]
}

[[- if .Inertia]]
// The [[.PluralW]] pages (frontend/src/pages/[[.Plural]]: yours to change), and
// their props. Their text is in locales/en/[[.Key]].yaml.
var (
	[[.Helper]]IndexPage = page[[print "["]][[.Plural]]IndexProps]("[[.Plural]]/Index")
	[[.Helper]]ShowPage  = page[[print "["]][[.Model]]Props]("[[.Plural]]/Show")
	[[.Helper]]FormPage  = page[[print "["]][[.Model]]FormProps]("[[.Plural]]/Form")
)

// [[.Model]]Item is a [[.Words]] as the pages get it: the fields chosen here, so
// a new column of the [[.Table]] table never shows by accident.
type [[.Model]]Item struct {
	ID int64 `json:"id"`
[[- range .Fields]]
	[[.Go]] [[.ResponseType]] `json:"[[.Name]]"`
[[- end]]
	CreatedAt time.Time `json:"created_at"`
}

// [[.Helper]]Item is row as the pages get it.
func [[.Helper]]Item(row models.[[.Model]]) [[.Model]]Item {
	item := [[.Model]]Item{
		ID: row.ID,
[[- range .Fields]][[if not .OptionalDate]]
		[[.Go]]: row.[[.Go]],
[[- end]][[end]]
		CreatedAt: row.CreatedAt,
	}
[[- range .Fields]][[if .OptionalDate]]
	if !row.[[.Go]].IsZero() {
		item.[[.Go]] = &row.[[.Go]] // null when empty
	}
[[- end]][[end]]
	return item
}

// [[.Plural]]IndexProps are the list's: a page of [[.PluralW]] (data, with
// current_page, last_page and total).
type [[.Plural]]IndexProps struct {
	Page db.Page[[print "["]][[.Model]]Item] `json:"page"`
}

// [[.Model]]Props are a [[.Words]]'s page's.
type [[.Model]]Props struct {
	Item [[.Model]]Item `json:"item"`
}

// [[.Model]]FormProps are the form's: the [[.Words]] being edited, null for a new
// one.
type [[.Model]]FormProps struct {
	Item *[[.Model]]Item `json:"item"`
}

[[ end -]]
// fill copies the form to the row.
func (in [[.Model]]Input) fill(row *models.[[.Model]]) {
[[- range .Fields]]
	row.[[.Go]] = in.[[.Go]]
[[- end]]
}

// Index lists the [[.PluralW]], newest first, 20 a page.
func ([[.Plural]]) Index(c *web.Ctx, in [[.Model]]List) (web.Responder, error) {
	page, err := db.Query[models.[[.Model]]](c).OrderBy(models.[[.Model]]Cols.ID.Desc()).Paginate(in.Page, 20)
	if err != nil {
		return nil, err
	}
[[- if .Inertia]]
	return [[.Helper]]IndexPage.Responder([[.Plural]]IndexProps{Page: db.MapPage(page, [[.Helper]]Item)}), nil
[[- else]]
	return web.Render(views.[[.Plural]]Page(page)), nil
[[- end]]
}

// Show shows a [[.Words]]; one that doesn't exist is a 404 (db.ErrNotFound).
func ([[.Plural]]) Show(c *web.Ctx, in [[.Model]]ID) (web.Responder, error) {
	row, err := db.Find[models.[[.Model]]](c, in.ID)
	if err != nil {
		return nil, err
	}
[[- if .Inertia]]
	return [[.Helper]]ShowPage.Responder([[.Model]]Props{Item: [[.Helper]]Item(row)}), nil
[[- else]]
	return web.Render(views.[[.Model]]Page(row)), nil
[[- end]]
}

// New shows the form for a new [[.Words]].
func ([[.Plural]]) New(c *web.Ctx) error {
[[- if .Inertia]]
	return [[.Helper]]FormPage.Render(c, [[.Model]]FormProps{})
[[- else]]
	return c.Render(http.StatusOK, views.[[.Model]]Form(models.[[.Model]]{}))
[[- end]]
}

// Create saves a new [[.Words]].
func ([[.Plural]]) Create(c *web.Ctx, in [[.Model]]Input) (web.Responder, error) {
	var row models.[[.Model]]
	in.fill(&row)
	if err := db.Create(c, &row); err != nil {
		return nil, err
	}
	c.Session().Flash("status", i18n.T(c, "[[.Key]].created"))
	return web.RedirectRoute("[[.Path]].show", row.ID), nil
}

// Edit shows the form to edit a [[.Words]].
func ([[.Plural]]) Edit(c *web.Ctx, in [[.Model]]ID) (web.Responder, error) {
	row, err := db.Find[models.[[.Model]]](c, in.ID)
	if err != nil {
		return nil, err
	}
[[- if .Inertia]]
	item := [[.Helper]]Item(row)
	return [[.Helper]]FormPage.Responder([[.Model]]FormProps{Item: &item}), nil
[[- else]]
	return web.Render(views.[[.Model]]Form(row)), nil
[[- end]]
}

// Update saves the changes to a [[.Words]].
func ([[.Plural]]) Update(c *web.Ctx, in [[.Model]]Input) (web.Responder, error) {
	row, err := db.Find[models.[[.Model]]](c, in.ID)
	if err != nil {
		return nil, err
	}
	in.fill(&row)
	if err := db.Update(c, &row); err != nil {
		return nil, err
	}
	c.Session().Flash("status", i18n.T(c, "[[.Key]].updated"))
	return web.RedirectRoute("[[.Path]].show", row.ID), nil
}

// Delete deletes a [[.Words]].
func ([[.Plural]]) Delete(c *web.Ctx, in [[.Model]]ID) (web.Responder, error) {
	row, err := db.Find[models.[[.Model]]](c, in.ID)
	if err != nil {
		return nil, err
	}
	if err := db.Delete(c, &row); err != nil {
		return nil, err
	}
	c.Session().Flash("status", i18n.T(c, "[[.Key]].deleted"))
	return web.RedirectRoute("[[.Path]].index"), nil
}
