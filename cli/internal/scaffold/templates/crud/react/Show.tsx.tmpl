import { Head, Link } from '@inertiajs/react'
import { [[if .HasBool]]Badge, [[end]]Card, Cluster, Detail, Details, LinkButton, [[if .HasText]]Multiline, [[end]]PageHeader, PostButton } from '../../components/ui'
import { useFormat, useT } from '../../i18n'
import type { PageProps } from '../../types/pages'
import { route } from '../../types/routes'

// [[.Plural]]/Show shows [[.AWords]], with the buttons to edit and delete it
// (anetos make:crud).
export default function Show({ item }: PageProps<'[[.Plural]]/Show'>) {
  const t = useT()
  const f = useFormat()
[[- if .TitleF]]
  const title = item.[[.TitleF.Name]]
[[- else]]
  const title = t('[[.Key]].one', { id: item.id })
[[- end]]
  return (
    <>
      <Head title={title} />
      <PageHeader title={title}>
        <Cluster>
          <LinkButton href={route('[[.Path]].edit', { id: item.id })} variant="secondary">
            {t('[[.Key]].edit')}
          </LinkButton>
          <PostButton href={route('[[.Path]].delete', { id: item.id })} method="delete" variant="danger">
            {t('[[.Key]].delete')}
          </PostButton>
        </Cluster>
      </PageHeader>
      <Card>
        <Details>
[[- range .Fields]]
          <Detail term={t('[[$.Key]].fields.[[.Name]]')}>
[[- if eq .Kind "text"]]
            <Multiline text={item.[[.Name]]} />
[[- else if eq .Kind "email"]]
            <a href={'mailto:' + item.[[.Name]]}>{item.[[.Name]]}</a>
[[- else if eq .Kind "bool"]]
            <YesNo yes={item.[[.Name]]} />
[[- else if or (eq .Kind "int") (eq .Kind "float")]]
            {f.number(item.[[.Name]])}
[[- else if eq .Kind "date"]]
            {item.[[.Name]] && f.date(item.[[.Name]])}
[[- else]]
            {item.[[.Name]]}
[[- end]]
          </Detail>
[[- end]]
          <Detail term={t('[[.Key]].created_at')}>{f.dateTime(item.created_at)}</Detail>
        </Details>
      </Card>
      <p>
        <Link href={route('[[.Path]].index')}>{t('[[.Key]].back')}</Link>
      </p>
    </>
  )
}
[[- if .HasBool]]

// YesNo shows a yes-or-no field.
function YesNo({ yes }: { yes: boolean }) {
  const t = useT()
  return yes ? <Badge tone="success">{t('[[.Key]].answer_yes')}</Badge> : <Badge>{t('[[.Key]].answer_no')}</Badge>
}
[[- end]]
