package views

import (
[[- if or .HasNum (not .TitleF)]]
	"strconv"

[[- end]]
	"anetos.dev/anetos/db"
	"anetos.dev/anetos/i18n"
	"anetos.dev/anetos/view"
	"anetos.dev/anetos/web"

	"[[.Module]]/app/models"
	"[[.Module]]/views/ui"
)

// The [[.PluralW]] pages (anetos make:crud): yours to change. Their text is in
// locales/en/[[.Key]].yaml.

// [[.Plural]]Page lists a page of [[.PluralW]], with links to the pages around it.
templ [[.Plural]]Page(page db.Page[models.[[.Model]]]) {
	@Layout(i18n.T(ctx, "[[.Key]].title")) {
		@ui.PageHeader(i18n.T(ctx, "[[.Key]].title"), "") {
			@ui.LinkButton(web.MustURL(ctx, "[[.Path]].new"), ui.Primary) {
				{ i18n.T(ctx, "[[.Key]].new") }
			}
		}
		if page.Total == 0 {
			@ui.Empty(i18n.T(ctx, "[[.Key]].empty"))
		} else {
			@ui.Table() {
				<thead>
					<tr>
[[- if not .TitleF]]
						<th>#</th>
[[- end]]
[[- range .ListFields]]
						<th>{ i18n.T(ctx, "[[$.Key]].fields.[[.Name]]") }</th>
[[- end]]
						<th>
							@ui.SROnly(i18n.T(ctx, "[[.Key]].actions"))
						</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range page.Data {
						<tr>
[[- if not .TitleF]]
							<td><a href={ web.URL(ctx, "[[.Path]].show", row.ID) }>{ strconv.FormatInt(row.ID, 10) }</a></td>
[[- end]]
[[- range .ListFields]]
[[- if and $.TitleF (eq .Name $.TitleF.Name)]]
							<td><a href={ web.URL(ctx, "[[$.Path]].show", row.ID) }>{ row.[[.Go]] }</a></td>
[[- else if eq .Kind "bool"]]
							<td>
								@[[$.Helper]]YesNo(row.[[.Go]])
							</td>
[[- else if or (eq .Kind "int") (eq .Kind "float")]]
							<td>{ i18n.Number(ctx, row.[[.Go]]) }</td>
[[- else if eq .Kind "date"]]
							<td>{ i18n.Date(ctx, row.[[.Go]]) }</td>
[[- else]]
							<td>{ row.[[.Go]] }</td>
[[- end]]
[[- end]]
							@ui.ActionsCell() {
								@ui.LinkButton(web.MustURL(ctx, "[[.Path]].edit", row.ID), ui.Secondary, ui.Small) {
									{ i18n.T(ctx, "[[.Key]].edit") }
								}
							}
						</tr>
					}
				</tbody>
			}
			if page.LastPage > 1 {
				@ui.Pagination(ui.PagesOf(ctx, page, i18n.T(ctx, "[[.Key]].pages"), i18n.T(ctx, "[[.Key]].page", "page", page.CurrentPage, "pages", page.LastPage), i18n.T(ctx, "[[.Key]].previous"), i18n.T(ctx, "[[.Key]].next")))
			}
		}
	}
}

// [[.Model]]Page shows a [[.Words]], with the buttons to edit and delete it.
templ [[.Model]]Page(row models.[[.Model]]) {
[[- if .TitleF]]
	@Layout(row.[[.TitleF.Go]]) {
[[- else]]
	@Layout(i18n.T(ctx, "[[.Key]].one", "id", row.ID)) {
[[- end]]
[[- if .TitleF]]
		@ui.PageHeader(row.[[.TitleF.Go]], "") {
[[- else]]
		@ui.PageHeader(i18n.T(ctx, "[[.Key]].one", "id", row.ID), "") {
[[- end]]
			@ui.Cluster() {
				@ui.LinkButton(web.MustURL(ctx, "[[.Path]].edit", row.ID), ui.Secondary) {
					{ i18n.T(ctx, "[[.Key]].edit") }
				}
				@ui.PostButton(web.MustURL(ctx, "[[.Path]].delete", row.ID), "DELETE", ui.Danger) {
					{ i18n.T(ctx, "[[.Key]].delete") }
				}
			}
		}
		@ui.Card("") {
			@ui.Details() {
[[- range .Fields]]
				@ui.Detail(i18n.T(ctx, "[[$.Key]].fields.[[.Name]]")) {
[[- if eq .Kind "text"]]
					@ui.Multiline(row.[[.Go]])
[[- else if eq .Kind "email"]]
					<a href={ templ.SafeURL("mailto:" + row.[[.Go]]) }>{ row.[[.Go]] }</a>
[[- else if eq .Kind "bool"]]
					@[[$.Helper]]YesNo(row.[[.Go]])
[[- else if or (eq .Kind "int") (eq .Kind "float")]]
					{ i18n.Number(ctx, row.[[.Go]]) }
[[- else if eq .Kind "date"]]
					{ i18n.Date(ctx, row.[[.Go]]) }
[[- else]]
					{ row.[[.Go]] }
[[- end]]
				}
[[- end]]
				@ui.Detail(i18n.T(ctx, "[[.Key]].created_at")) {
					{ i18n.DateTime(ctx, row.CreatedAt) }
				}
			}
		}
		<p><a href={ web.URL(ctx, "[[.Path]].index") }>{ i18n.T(ctx, "[[.Key]].back") }</a></p>
	}
}

// [[.Model]]Form creates a [[.Words]], or edits one when its ID is set. After a
// failed post, view.Old refills the fields and view.Errors has the
// messages.
templ [[.Model]]Form(row models.[[.Model]]) {
	if row.ID == 0 {
		@Layout(i18n.T(ctx, "[[.Key]].new")) {
			@ui.Narrow() {
				<h1>{ i18n.T(ctx, "[[.Key]].new") }</h1>
				@ui.Card("") {
					@ui.Form(web.MustURL(ctx, "[[.Path]].create"), "POST", nil) {
						@[[.Helper]]Fields(row)
					}
				}
			}
		}
	} else {
		@Layout(i18n.T(ctx, "[[.Key]].editing")) {
			@ui.Narrow() {
				<h1>{ i18n.T(ctx, "[[.Key]].editing") }</h1>
				@ui.Card("") {
					@ui.Form(web.MustURL(ctx, "[[.Path]].update", row.ID), "PUT", nil) {
						@[[.Helper]]Fields(row)
					}
				}
			}
		}
	}
}

// [[.Helper]]Fields are the form's fields and buttons.
templ [[.Helper]]Fields(row models.[[.Model]]) {
[[- range .Fields]]
[[- if eq .Kind "bool"]]
	@ui.Field("[[.Name]]", "", "") {
		@ui.Checkbox("[[.Name]]", i18n.T(ctx, "[[$.Key]].fields.[[.Name]]"), view.OldChecked(ctx, "[[.Name]]", row.[[.Go]]), nil)
	}
[[- else]]
	@ui.Field("[[.Name]]", i18n.T(ctx, "[[$.Key]].fields.[[.Name]]"), "") {
[[- if eq .Kind "text"]]
		@ui.Textarea("[[.Name]]", view.Old(ctx, "[[.Name]]", row.[[.Go]]), templ.Attributes{"rows": "6"})
[[- else if eq .Kind "email"]]
		@ui.Input("[[.Name]]", "email", view.Old(ctx, "[[.Name]]", row.[[.Go]]), nil)
[[- else if eq .Kind "int"]]
		@ui.Input("[[.Name]]", "number", view.Old(ctx, "[[.Name]]", strconv.FormatInt(row.[[.Go]], 10)), templ.Attributes{"step": "1"})
[[- else if eq .Kind "float"]]
		@ui.Input("[[.Name]]", "number", view.Old(ctx, "[[.Name]]", strconv.FormatFloat(row.[[.Go]], 'f', -1, 64)), templ.Attributes{"step": "any"})
[[- else if eq .Kind "date"]]
		@ui.Input("[[.Name]]", "date", view.Old(ctx, "[[.Name]]", row.[[.Go]].String()), nil)
[[- else if eq .Kind "string"]]
		@ui.Input("[[.Name]]", "", view.Old(ctx, "[[.Name]]", row.[[.Go]]), nil)
[[- end]]
	}
[[- end]]
[[- end]]
	@ui.Actions() {
		@ui.Button(ui.Primary, nil) {
			{ i18n.T(ctx, "[[.Key]].save") }
		}
		if row.ID == 0 {
			<a href={ web.URL(ctx, "[[.Path]].index") }>{ i18n.T(ctx, "[[.Key]].cancel") }</a>
		} else {
			<a href={ web.URL(ctx, "[[.Path]].show", row.ID) }>{ i18n.T(ctx, "[[.Key]].cancel") }</a>
		}
	}
}

[[- if .HasBool]]

// [[.Helper]]YesNo shows a yes-or-no field.
templ [[.Helper]]YesNo(yes bool) {
	if yes {
		@ui.Badge(ui.Success) {
			{ i18n.T(ctx, "[[.Key]].answer_yes") }
		}
	} else {
		@ui.Badge(ui.Neutral) {
			{ i18n.T(ctx, "[[.Key]].answer_no") }
		}
	}
}
[[- end]]
