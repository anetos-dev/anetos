package views

import (
	"anetos.dev/anetos/auth"
	"anetos.dev/anetos/i18n"
	"anetos.dev/anetos/view"
	"anetos.dev/anetos/web"

	"[[.Module]]/app/models"
)

// The account pages (anetos make:auth): yours to change. Their text is
// in locales/en/auth.yaml.

// SocialButton is a "Sign in with …" button.
type SocialButton struct {
	Name  string // the provider in URLs: google
	Title string // its name for people: Google
}

// Register is the registration form.
templ Register(social []SocialButton) {
	@Layout(i18n.T(ctx, "auth.register.title")) {
		<h1>{ i18n.T(ctx, "auth.register.title") }</h1>
		<form method="post" action={ web.URL(ctx, "register") }>
			@view.CSRFField(ctx)
			<label for="name">{ i18n.T(ctx, "auth.fields.name") }</label>
			<input id="name" name="name" autocomplete="name" value={ view.Old(ctx, "name") }/>
			@authError("name")
			<label for="email">{ i18n.T(ctx, "auth.fields.email") }</label>
			<input id="email" name="email" type="email" autocomplete="email" value={ view.Old(ctx, "email") }/>
			@authError("email")
			<label for="password">{ i18n.T(ctx, "auth.fields.password") }</label>
			<input id="password" name="password" type="password" autocomplete="new-password"/>
			@authError("password")
			<label for="password_confirmation">{ i18n.T(ctx, "auth.fields.password_confirmation") }</label>
			<input id="password_confirmation" name="password_confirmation" type="password" autocomplete="new-password"/>
			<p><button type="submit">{ i18n.T(ctx, "auth.register.submit") }</button></p>
		</form>
		@socialButtons(social)
		<p>{ i18n.T(ctx, "auth.register.have_account") } <a href={ web.URL(ctx, "login") }>{ i18n.T(ctx, "auth.login.title") }</a></p>
	}
}

// Login is the login form.
templ Login(social []SocialButton) {
	@Layout(i18n.T(ctx, "auth.login.title")) {
		<h1>{ i18n.T(ctx, "auth.login.title") }</h1>
		<form method="post" action={ web.URL(ctx, "login") }>
			@view.CSRFField(ctx)
			<label for="email">{ i18n.T(ctx, "auth.fields.email") }</label>
			<input id="email" name="email" type="email" autocomplete="email" value={ view.Old(ctx, "email") }/>
			@authError("email")
			<label for="password">{ i18n.T(ctx, "auth.fields.password") }</label>
			<input id="password" name="password" type="password" autocomplete="current-password"/>
			@authError("password")
			<label><input type="checkbox" name="remember" value="1"/> { i18n.T(ctx, "auth.login.remember") }</label>
			<p><button type="submit">{ i18n.T(ctx, "auth.login.submit") }</button></p>
		</form>
		@socialButtons(social)
		<p><a href={ web.URL(ctx, "password.request") }>{ i18n.T(ctx, "auth.forgot.title") }</a> · <a href={ web.URL(ctx, "register") }>{ i18n.T(ctx, "auth.register.title") }</a></p>
	}
}

// ForgotPassword asks for the address to send a reset link to.
templ ForgotPassword() {
	@Layout(i18n.T(ctx, "auth.forgot.title")) {
		<h1>{ i18n.T(ctx, "auth.forgot.title") }</h1>
		<p>{ i18n.T(ctx, "auth.forgot.intro") }</p>
		<form method="post" action={ web.URL(ctx, "password.email") }>
			@view.CSRFField(ctx)
			<label for="email">{ i18n.T(ctx, "auth.fields.email") }</label>
			<input id="email" name="email" type="email" autocomplete="email" value={ view.Old(ctx, "email") }/>
			@authError("email")
			<p><button type="submit">{ i18n.T(ctx, "auth.forgot.submit") }</button></p>
		</form>
	}
}

// ResetPassword is the new-password form of a reset link.
templ ResetPassword(token string) {
	@Layout(i18n.T(ctx, "auth.reset.title")) {
		<h1>{ i18n.T(ctx, "auth.reset.title") }</h1>
		<form method="post" action={ web.URL(ctx, "password.update") }>
			@view.CSRFField(ctx)
			<input type="hidden" name="token" value={ token }/>
			<label for="password">{ i18n.T(ctx, "auth.fields.new_password") }</label>
			<input id="password" name="password" type="password" autocomplete="new-password"/>
			@authError("password")
			<label for="password_confirmation">{ i18n.T(ctx, "auth.fields.password_confirmation") }</label>
			<input id="password_confirmation" name="password_confirmation" type="password" autocomplete="new-password"/>
			<p><button type="submit">{ i18n.T(ctx, "auth.reset.submit") }</button></p>
		</form>
	}
}

// Dashboard shows the account and its API tokens; newToken is a token
// just created, shown once.
templ Dashboard(u *models.User, tokens []auth.Token, newToken string) {
	@Layout(i18n.T(ctx, "auth.dashboard.title")) {
		<h1>{ i18n.T(ctx, "auth.dashboard.hello", "name", u.Name) }</h1>
		if u.EmailVerifiedAt == nil {
			<p>{ i18n.T(ctx, "auth.dashboard.verify") }</p>
			<form method="post" action={ web.URL(ctx, "verification.send") }>
				@view.CSRFField(ctx)
				<button type="submit">{ i18n.T(ctx, "auth.dashboard.resend") }</button>
			</form>
		}
		<form method="post" action={ web.URL(ctx, "logout") }>
			@view.CSRFField(ctx)
			<button type="submit">{ i18n.T(ctx, "auth.dashboard.logout") }</button>
		</form>
		<p><a href={ web.URL(ctx, "settings") }>{ i18n.T(ctx, "auth.settings.title") }</a></p>
		<h2>{ i18n.T(ctx, "auth.tokens.title") }</h2>
		if newToken != "" {
			<p>{ i18n.T(ctx, "auth.tokens.new") } <code>{ newToken }</code></p>
		}
		<ul>
			for _, t := range tokens {
				<li>
					{ t.Name }
					<form method="post" action={ web.URL(ctx, "tokens.destroy", t.ID) }>
						@view.CSRFField(ctx)
						<button type="submit">{ i18n.T(ctx, "auth.tokens.revoke") }</button>
					</form>
				</li>
			}
		</ul>
		<form method="post" action={ web.URL(ctx, "tokens.store") }>
			@view.CSRFField(ctx)
			<label for="token-name">{ i18n.T(ctx, "auth.tokens.name") }</label>
			<input id="token-name" name="name"/>
			@authError("name")
			<p><button type="submit">{ i18n.T(ctx, "auth.tokens.create") }</button></p>
		</form>
	}
}

