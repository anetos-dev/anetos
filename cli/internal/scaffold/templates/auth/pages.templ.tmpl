	@Layout(i18n.T(ctx, "auth.challenge.title")) {
		<h1>{ i18n.T(ctx, "auth.challenge.title") }</h1>
		<p>{ i18n.T(ctx, "auth.challenge.intro") }</p>
		<form method="post" action={ web.URL(ctx, "two-factor.challenge") }>
			@view.CSRFField(ctx)
			<label for="code">{ i18n.T(ctx, "auth.fields.code") }</label>
			<input id="code" name="code" autocomplete="one-time-code" autofocus/>
