// TwoFactorPage is what the two-factor page shows.
type TwoFactorPage struct {
	Status        auth.TwoFactorStatus
	Secret        string   // being set up: the key, to type in
	QR            string   // being set up: the QR code, as SVG
	RecoveryCodes []string // just made: shown once
}

// TwoFactor turns two-factor sign-in on and off.
templ TwoFactor(p TwoFactorPage) {
	@Layout(i18n.T(ctx, "auth.two_factor.title")) {
		<h1>{ i18n.T(ctx, "auth.two_factor.title") }</h1>
		if len(p.RecoveryCodes) > 0 {
			<p>{ i18n.T(ctx, "auth.two_factor.codes") }</p>
			<ul>
				for _, c := range p.RecoveryCodes {
					<li><code>{ c }</code></li>
				}
			</ul>
		}
		switch {
			case p.Status.On:
				<p>{ i18n.Plural(ctx, "auth.two_factor.on", p.Status.RecoveryCodes) }</p>
				<form method="post" action={ web.URL(ctx, "two-factor.recovery-codes") }>
					@view.CSRFField(ctx)
					<button type="submit">{ i18n.T(ctx, "auth.two_factor.new_codes") }</button>
				</form>
				<form method="post" action={ web.URL(ctx, "two-factor.disable") }>
					@view.CSRFField(ctx)
					<button type="submit">{ i18n.T(ctx, "auth.two_factor.disable") }</button>
				</form>
			case p.Status.Started:
				<p>{ i18n.T(ctx, "auth.two_factor.scan") }</p>
				<p class="qr">
					@templ.Raw(p.QR)
				</p>
				<p>{ i18n.T(ctx, "auth.two_factor.key") } <code>{ p.Secret }</code></p>
				<form method="post" action={ web.URL(ctx, "two-factor.confirm") }>
					@view.CSRFField(ctx)
					<label for="code">{ i18n.T(ctx, "auth.fields.code") }</label>
					<input id="code" name="code" autocomplete="one-time-code" inputmode="numeric"/>
					@authError("code")
					<p><button type="submit">{ i18n.T(ctx, "auth.two_factor.confirm") }</button></p>
				</form>
			default:
				<p>{ i18n.T(ctx, "auth.two_factor.off") }</p>
				<form method="post" action={ web.URL(ctx, "two-factor.start") }>
					@view.CSRFField(ctx)
					<button type="submit">{ i18n.T(ctx, "auth.two_factor.enable") }</button>
				</form>
		}
		<p><a href={ web.URL(ctx, "dashboard") }>{ i18n.T(ctx, "auth.dashboard.title") }</a></p>
	}
}

// socialButtons shows a link per provider, and why a sign-in failed.
templ socialButtons(buttons []SocialButton) {
	if len(buttons) > 0 {
		<p>
			for _, b := range buttons {
				<a href={ web.URL(ctx, "social.redirect", b.Name) }>{ i18n.T(ctx, "auth.social.sign_in_with", "provider", b.Title) }</a>
				{ " " }
			}
		</p>
	}
	@authError("social")
}

// authError shows the validation message for a field, if any.
templ authError(field string) {
	if msg := view.Errors(ctx).Get(field); msg != "" {
		<p class="error">{ msg }</p>
	}
}
