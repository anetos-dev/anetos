import { Form, Head } from '@inertiajs/react'
import { Actions, AuthCard, Button, Field, Input } from '../../components/ui'
import { useT } from '../../i18n'
import type { PageProps } from '../../types/pages'
import { route } from '../../types/routes'

// Auth/ResetPassword is the new-password form of an emailed reset link
// (anetos make:auth).
export default function ResetPassword({ token }: PageProps<'Auth/ResetPassword'>) {
  const t = useT()
  return (
    <AuthCard title={t('auth.reset.title')}>
      <Head title={t('auth.reset.title')} />
      <Form action={route('password.update')} method="post" resetOnError>
        {({ errors, processing }) => (
          <>
            <input type="hidden" name="token" value={token} />
            <Field name="password" label={t('auth.fields.new_password')} error={errors.password ?? errors.token}>
              <Input type="password" autoComplete="new-password" />
            </Field>
            <Field name="password_confirmation" label={t('auth.fields.password_confirmation')} error={errors.password_confirmation}>
              <Input type="password" autoComplete="new-password" />
            </Field>
            <Actions>
              <Button disabled={processing}>{t('auth.reset.submit')}</Button>
            </Actions>
          </>
        )}
      </Form>
    </AuthCard>
  )
}
