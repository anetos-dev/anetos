import { Form, Head } from '@inertiajs/react'
import { Button, Card, Cluster, Field, Input, LinkButton, Narrow, PageHeader, PostButton } from '../../components/ui'
import { useT } from '../../i18n'
import type { PageProps } from '../../types/pages'
import { route } from '../../types/routes'

// Auth/TwoFactor turns two-factor authentication on and off (anetos
// make:auth): off, being set up (the QR code to scan), or on; and the
// recovery codes once, just after they're made.
export default function TwoFactor({ on, started, recoveryCodesLeft, secret, qr, recoveryCodes }: PageProps<'Auth/TwoFactor'>) {
  const t = useT()
  return (
    <Narrow>
      <Head title={t('auth.two_factor.title')} />
      <PageHeader title={t('auth.two_factor.title')}>
        <LinkButton href={route('settings')} variant="secondary">
          {t('auth.settings.title')}
        </LinkButton>
      </PageHeader>
      <Card>
        {recoveryCodes.length > 0 && (
          <>
            <p>{t('auth.two_factor.codes')}</p>
            <ul>
              {recoveryCodes.map((c) => (
                <li key={c}>
                  <code>{c}</code>
                </li>
              ))}
            </ul>
          </>
        )}
        {on ? (
          <>
            <p>{t('auth.two_factor.on', { count: recoveryCodesLeft })}</p>
            <Cluster>
              <PostButton href={route('two-factor.recovery-codes')} variant="secondary">
                {t('auth.two_factor.new_codes')}
              </PostButton>
              <PostButton href={route('two-factor.disable')} variant="danger">
                {t('auth.two_factor.disable')}
              </PostButton>
            </Cluster>
          </>
        ) : started ? (
          <>
            <p>{t('auth.two_factor.scan')}</p>
            {/* The server's SVG of the QR code (package qr). */}
            <p dangerouslySetInnerHTML={{ __html: qr }} />
            <p>
              {t('auth.two_factor.key')} <code>{secret}</code>
            </p>
            <Form action={route('two-factor.confirm')} method="post" resetOnError>
              {({ errors, processing }) => (
                <>
                  <Field name="code" label={t('auth.fields.code')} error={errors.code}>
                    <Input autoComplete="one-time-code" inputMode="numeric" />
                  </Field>
                  <Button disabled={processing}>{t('auth.two_factor.confirm')}</Button>
                </>
              )}
            </Form>
          </>
        ) : (
          <>
            <p>{t('auth.two_factor.off')}</p>
            <PostButton href={route('two-factor.start')}>
              {t('auth.two_factor.enable')}
            </PostButton>
          </>
        )}
      </Card>
    </Narrow>
  )
}
