import { Form, Head } from '@inertiajs/react'
import { Badge, Button, Card, Field, Input, LinkButton, Narrow, Note, PageHeader, PostButton, Select } from '../../components/ui'
import { useT } from '../../i18n'
import type { PageProps } from '../../types/pages'
import { route } from '../../types/routes'

// Auth/Settings is the account settings page (anetos make:auth): yours
// to change, and to add your own fields to (and to
// app/handlers/settings.go). Its text is in locales/en/auth.yaml.
export default function Settings(p: PageProps<'Auth/Settings'>) {
  const t = useT()
  const locales = [{ value: '', label: t('auth.settings.language_auto') }, ...p.locales.map((l) => ({ value: l.value, label: l.title }))]
  const zones = [{ value: '', label: t('auth.settings.time_zone_app') }, ...p.timeZones.map((z) => ({ value: z, label: z }))]
  return (
    <Narrow>
      <Head title={t('auth.settings.title')} />
      <PageHeader title={t('auth.settings.title')}>
        <LinkButton href={route('dashboard')} variant="secondary">
          {t('auth.dashboard.title')}
        </LinkButton>
      </PageHeader>

      <Card title={t('auth.settings.profile')}>
        <Form action={route('settings.profile')} method="post">
          {({ errors, processing }) => (
            <>
              <Field name="name" label={t('auth.fields.name')} error={errors.name}>
                <Input autoComplete="name" defaultValue={p.name} />
              </Field>
              <Button disabled={processing}>{t('auth.settings.save')}</Button>
            </>
          )}
        </Form>
      </Card>

      <Card title={t('auth.fields.email')}>
        <p>
          {p.email}
          {!p.emailVerified && (
            <>
              {' '}
              <Badge tone="warning">{t('auth.settings.unverified')}</Badge>
            </>
          )}
        </p>
        {p.emailUrl && (
          <>
            {p.pendingEmail && (
              <>
                <p>{t('auth.settings.email_pending', { email: p.pendingEmail })}</p>
                <PostButton href={route('settings.email.cancel')} variant="secondary">
                  {t('auth.settings.email_cancel')}
                </PostButton>
              </>
            )}
            <Form action={p.emailUrl} method="post" resetOnSuccess>
              {({ errors, processing }) => (
                <>
                  <Field name="email" label={t('auth.settings.new_email')} error={errors.email}>
                    <Input type="email" autoComplete="email" />
                  </Field>
                  <Button disabled={processing}>{t('auth.settings.email_change')}</Button>
                </>
              )}
            </Form>
          </>
        )}
      </Card>

      <Card title={t('auth.fields.password')}>
        <Form action={route('settings.password')} method="post" resetOnSuccess resetOnError>
          {({ errors, processing }) => (
            <>
              {p.hasPassword ? (
                <Field name="current_password" label={t('auth.fields.current_password')} error={errors.current_password}>
                  <Input type="password" autoComplete="current-password" />
                </Field>
              ) : (
                <Note>{t('auth.settings.no_password')}</Note>
              )}
              <Field name="password" label={t('auth.fields.new_password')} error={errors.password}>
                <Input type="password" autoComplete="new-password" />
              </Field>
              <Field name="password_confirmation" label={t('auth.fields.password_confirmation')} error={errors.password_confirmation}>
                <Input type="password" autoComplete="new-password" />
              </Field>
              <Button disabled={processing}>{t('auth.settings.password_change')}</Button>
            </>
          )}
        </Form>
      </Card>

      <Card title={t('auth.settings.preferences')}>
        <Form action={route('settings.preferences')} method="post">
          {({ errors, processing }) => (
            <>
              <Field name="locale" label={t('auth.settings.language')} error={errors.locale}>
                <Select options={locales} defaultValue={p.locale} />
              </Field>
              <Field name="time_zone" label={t('auth.settings.time_zone')} error={errors.time_zone}>
                <Select options={zones} defaultValue={p.timeZone} />
              </Field>
              <Button disabled={processing}>{t('auth.settings.save')}</Button>
            </>
          )}
        </Form>
      </Card>

      {p.twoFactor && (
        <Card title={t('auth.two_factor.title')}>
          <p>
            {p.twoFactorOn ? (
              <Badge tone="success">{t('auth.settings.two_factor_on')}</Badge>
            ) : (
              <Badge>{t('auth.settings.two_factor_off')}</Badge>
            )}
          </p>
          <LinkButton href={route('two-factor')} variant="secondary">
            {t('auth.settings.two_factor_manage')}
          </LinkButton>
        </Card>
      )}

      {p.deleteUrl && (
        <Card title={t('auth.settings.delete')}>
          <Note>{t('auth.settings.delete_intro')}</Note>
          <PostButton href={p.deleteUrl} variant="danger">
            {t('auth.settings.delete_button')}
          </PostButton>
        </Card>
      )}
    </Narrow>
  )
}
