import { Form, Head } from '@inertiajs/react'
import { Actions, AuthCard, Button, Field, Input, Note } from '../../components/ui'
import { useT } from '../../i18n'
import { route } from '../../types/routes'

// Auth/ForgotPassword asks for the address to email a reset link to
// (anetos make:auth).
export default function ForgotPassword() {
  const t = useT()
  return (
    <AuthCard title={t('auth.forgot.title')}>
      <Head title={t('auth.forgot.title')} />
      <Note>{t('auth.forgot.intro')}</Note>
      <Form action={route('password.email')} method="post">
        {({ errors, processing }) => (
          <>
            <Field name="email" label={t('auth.fields.email')} error={errors.email}>
              <Input type="email" autoComplete="email" />
            </Field>
            <Actions>
              <Button disabled={processing}>{t('auth.forgot.submit')}</Button>
            </Actions>
          </>
        )}
      </Form>
    </AuthCard>
  )
}
