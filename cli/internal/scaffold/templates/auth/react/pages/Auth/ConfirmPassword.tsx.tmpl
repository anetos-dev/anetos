import { Form, Head } from '@inertiajs/react'
import { Actions, AuthCard, Button, Field, Input, Note } from '../../components/ui'
import { useT } from '../../i18n'
import { route } from '../../types/routes'

// Auth/ConfirmPassword asks for the password again, before something
// sensitive (anetos make:auth).
export default function ConfirmPassword() {
  const t = useT()
  return (
    <AuthCard title={t('auth.confirm.title')}>
      <Head title={t('auth.confirm.title')} />
      <Note>{t('auth.confirm.intro')}</Note>
      <Form action={route('password.confirm')} method="post" resetOnError>
        {({ errors, processing }) => (
          <>
            <Field name="password" label={t('auth.fields.password')} error={errors.password}>
              <Input type="password" autoComplete="current-password" autoFocus />
            </Field>
            <Actions>
              <Button disabled={processing}>{t('auth.confirm.submit')}</Button>
            </Actions>
          </>
        )}
      </Form>
    </AuthCard>
  )
}
