<script setup lang="ts">
// SocialButtons are the "Log in with …" buttons, and why such a login
// failed (the social error). They are links, not Inertia visits: they
// leave the site for the provider's page.
import { useT } from '../i18n'
import type { SocialButton } from '../types/api'
import { route } from '../types/routes'
import { Note, Stack } from './ui'

defineProps<{ social: SocialButton[]; error?: string }>()
const t = useT()
</script>

<template>
  <template v-if="social.length > 0">
    <Note>{{ t('auth.social.or') }}</Note>
    <Stack>
      <a v-for="b in social" :key="b.name" class="button secondary full" :href="route('social.redirect', { provider: b.name })">
        {{ t('auth.social.login_with', { provider: b.title }) }}
      </a>
    </Stack>
  </template>
  <p v-if="error" class="error">{{ error }}</p>
</template>
