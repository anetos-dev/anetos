<script setup lang="ts">
// AccountMenu is the header's account links (anetos make:auth): the
// logged-in user's dashboard, settings and logout, or log in and
// register. The user is a shared prop (handlers.SharedProps).
import { usePage } from '@inertiajs/vue3'
import { useT } from '../i18n'
import { route } from '../types/routes'
import NavLink from './NavLink.vue'
import { LinkButton, PostButton } from './ui'

const page = usePage()
const t = useT()
</script>

<template>
  <template v-if="page.props.user">
    <NavLink route="dashboard" :label="page.props.user.name" />
    <NavLink route="settings" :label="t('auth.settings.title')" />
    <PostButton :href="route('logout')" variant="ghost">{{ t('auth.dashboard.logout') }}</PostButton>
  </template>
  <template v-else>
    <NavLink route="login" :label="t('auth.login.title')" />
    <LinkButton :href="route('register')" small>{{ t('auth.register.title') }}</LinkButton>
  </template>
</template>
