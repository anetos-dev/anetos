package views

import (
	"anetos.dev/anetos/auth"
	"anetos.dev/anetos/i18n"
	"anetos.dev/anetos/view"
	"anetos.dev/anetos/web"

	"[[.Module]]/app/models"
)

// The account settings page (anetos make:auth): yours to change, and to
// add your own fields to. Its text is in locales/en/auth.yaml.

// Choice is an option of a select: its value and its name for people.
type Choice struct {
	Value, Title string
}

// SettingsPage is what the settings page shows.
type SettingsPage struct {
	User            *models.User
	Locales         []Choice // the app's languages
	TimeZones       []string // i18n.TimeZones
	EmailChange     bool     // users may change their address
	DeleteAccount   bool     // users may delete their account
	TwoFactor       bool     // two-factor sign-in is available
	TwoFactorStatus auth.TwoFactorStatus
}

// Settings is the account settings page.
templ Settings(p SettingsPage) {
	@Layout(i18n.T(ctx, "auth.settings.title")) {
		<div class="narrow">
			<div class="page-header">
				<h1>{ i18n.T(ctx, "auth.settings.title") }</h1>
				<a class="button secondary" href={ web.URL(ctx, "dashboard") }>{ i18n.T(ctx, "auth.dashboard.title") }</a>
			</div>

			<section class="card">
				<h2>{ i18n.T(ctx, "auth.settings.profile") }</h2>
				<form method="post" action={ web.URL(ctx, "settings.profile") }>
					@view.CSRFField(ctx)
					<div class="field">
						<label for="name">{ i18n.T(ctx, "auth.fields.name") }</label>
						<input id="name" name="name" autocomplete="name" value={ view.Old(ctx, "name", p.User.Name) }/>
						@authError("name")
					</div>
					<button type="submit">{ i18n.T(ctx, "auth.settings.save") }</button>
				</form>
			</section>

			<section class="card">
				<h2>{ i18n.T(ctx, "auth.fields.email") }</h2>
				<p>
					{ p.User.Email }
					if p.User.EmailVerifiedAt == nil {
						{ " " }<span class="badge warning">{ i18n.T(ctx, "auth.settings.unverified") }</span>
					}
				</p>
				if p.EmailChange {
					if p.User.PendingEmail != "" {
						<p>{ i18n.T(ctx, "auth.settings.email_pending", "email", p.User.PendingEmail) }</p>
						<form method="post" action={ web.URL(ctx, "settings.email.cancel") }>
							@view.CSRFField(ctx)
							<button type="submit" class="secondary">{ i18n.T(ctx, "auth.settings.email_cancel") }</button>
						</form>
					}
					<form method="post" action={ web.URL(ctx, "settings.email") }>
						@view.CSRFField(ctx)
						<div class="field">
							<label for="email">{ i18n.T(ctx, "auth.settings.new_email") }</label>
							<input id="email" name="email" type="email" autocomplete="email" value={ view.Old(ctx, "email") }/>
							@authError("email")
						</div>
						<button type="submit">{ i18n.T(ctx, "auth.settings.email_change") }</button>
					</form>
				}
			</section>

			<section class="card">
				<h2>{ i18n.T(ctx, "auth.fields.password") }</h2>
				<form method="post" action={ web.URL(ctx, "settings.password") }>
					@view.CSRFField(ctx)
					if p.User.Password != "" {
						<div class="field">
							<label for="current_password">{ i18n.T(ctx, "auth.fields.current_password") }</label>
							<input id="current_password" name="current_password" type="password" autocomplete="current-password"/>
							@authError("current_password")
						</div>
					} else {
						<p class="muted">{ i18n.T(ctx, "auth.settings.no_password") }</p>
					}
					<div class="field">
						<label for="password">{ i18n.T(ctx, "auth.fields.new_password") }</label>
						<input id="password" name="password" type="password" autocomplete="new-password"/>
						@authError("password")
					</div>
					<div class="field">
						<label for="password_confirmation">{ i18n.T(ctx, "auth.fields.password_confirmation") }</label>
						<input id="password_confirmation" name="password_confirmation" type="password" autocomplete="new-password"/>
					</div>
					<button type="submit">{ i18n.T(ctx, "auth.settings.password_change") }</button>
				</form>
			</section>

			<section class="card">
				<h2>{ i18n.T(ctx, "auth.settings.preferences") }</h2>
				<form method="post" action={ web.URL(ctx, "settings.preferences") }>
					@view.CSRFField(ctx)
					<div class="field">
						<label for="locale">{ i18n.T(ctx, "auth.settings.language") }</label>
						<select id="locale" name="locale">
							<option value="">{ i18n.T(ctx, "auth.settings.language_auto") }</option>
							for _, l := range p.Locales {
								<option value={ l.Value } selected?={ l.Value == p.User.Locale }>{ l.Title }</option>
							}
						</select>
						@authError("locale")
					</div>
					<div class="field">
						<label for="time_zone">{ i18n.T(ctx, "auth.settings.time_zone") }</label>
						<select id="time_zone" name="time_zone">
							<option value="">{ i18n.T(ctx, "auth.settings.time_zone_app") }</option>
							for _, z := range p.TimeZones {
								<option value={ z } selected?={ z == p.User.TimeZone }>{ z }</option>
							}
						</select>
						@authError("time_zone")
					</div>
					<button type="submit">{ i18n.T(ctx, "auth.settings.save") }</button>
				</form>
			</section>

			if p.TwoFactor {
				<section class="card">
					<h2>{ i18n.T(ctx, "auth.two_factor.title") }</h2>
					<p>
						if p.TwoFactorStatus.On {
							<span class="badge success">{ i18n.T(ctx, "auth.settings.two_factor_on") }</span>
						} else {
							<span class="badge">{ i18n.T(ctx, "auth.settings.two_factor_off") }</span>
						}
					</p>
					<a class="button secondary" href={ web.URL(ctx, "two-factor") }>{ i18n.T(ctx, "auth.settings.two_factor_manage") }</a>
				</section>
			}

			if p.DeleteAccount {
				<section class="card">
					<h2>{ i18n.T(ctx, "auth.settings.delete") }</h2>
					<p class="muted">{ i18n.T(ctx, "auth.settings.delete_intro") }</p>
					<form method="post" action={ web.URL(ctx, "settings.delete") }>
						@view.CSRFField(ctx)
						<button type="submit" class="danger">{ i18n.T(ctx, "auth.settings.delete_button") }</button>
					</form>
				</section>
			}
		</div>
	}
}

// RevertEmail asks the owner of an account's old address to confirm
// undoing its change to newEmail.
templ RevertEmail(token, oldEmail, newEmail string) {
	@Layout(i18n.T(ctx, "auth.revert.title")) {
		<div class="card auth-card">
			<h1>{ i18n.T(ctx, "auth.revert.title") }</h1>
			<p>{ i18n.T(ctx, "auth.revert.intro", "old", oldEmail, "new", newEmail) }</p>
			<form method="post" action={ web.URL(ctx, "settings.email.revert") }>
				@view.CSRFField(ctx)
				<input type="hidden" name="token" value={ token }/>
				<button type="submit" class="danger">{ i18n.T(ctx, "auth.revert.submit") }</button>
			</form>
		</div>
	}
}
