package views

// The account emails' HTML bodies (anetos make:auth). Mail clients ignore
// most CSS: the styles are inline. The text bodies are made from these.

// VerifyEmailMail asks name to verify their address with url.
templ VerifyEmailMail(name, url string) {
	@authMail() {
		<p>Hello { name },</p>
		<p>Please confirm your email address:</p>
		<p><a href={ templ.SafeURL(url) } style="display:inline-block;padding:10px 16px;background:#1d1d1f;color:#ffffff;text-decoration:none;border-radius:6px">Verify my email address</a></p>
		<p>If you didn't create an account, ignore this email.</p>
	}
}

// ResetPasswordMail sends name a password reset link, url.
templ ResetPasswordMail(name, url string) {
	@authMail() {
		<p>Hello { name },</p>
		<p>Someone asked to reset the password of your account. If it was you:</p>
		<p><a href={ templ.SafeURL(url) } style="display:inline-block;padding:10px 16px;background:#1d1d1f;color:#ffffff;text-decoration:none;border-radius:6px">Choose a new password</a></p>
		<p>The link expires soon, and works once. If you didn't ask, ignore this email: your password stays the same.</p>
	}
}

// authMail is the account emails' shell.
templ authMail() {
	<!DOCTYPE html>
	<html>
		<body style="margin:0;padding:24px;background:#f4f4f5;font-family:Arial,sans-serif;color:#18181b">
			<div style="max-width:560px;margin:0 auto;padding:24px;background:#ffffff;border-radius:8px">
				{ children... }
			</div>
		</body>
	</html>
}
