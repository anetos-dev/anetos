<script lang="ts">
  // Auth/ResetPassword is the new-password form of an emailed reset link
  // (anetos make:auth).
  import { Form } from '@inertiajs/svelte'
  import { Actions, AuthCard, Button, Field, Input, Title } from '../../components/ui'
  import { useT } from '../../i18n'
  import { route } from '../../routes'
  import type { ResetProps } from '../../types/pages'

  let { token }: ResetProps = $props()
  const t = useT()
</script>

