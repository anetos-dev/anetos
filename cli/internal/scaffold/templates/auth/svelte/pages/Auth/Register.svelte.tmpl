<script lang="ts">
  // Auth/Register is the registration form (anetos make:auth): yours to
  // change. Its text is in locales/en/auth.yaml.
  import { Form, Link } from '@inertiajs/svelte'
  import SocialButtons from '../../components/SocialButtons.svelte'
  import { Actions, AuthCard, Button, Field, Input, Note, Title } from '../../components/ui'
  import { useT } from '../../i18n'
  import { route } from '../../routes'
  import type { Errors, SocialProps } from '../../types/pages'

  let { social, errors: pageErrors }: SocialProps & { errors: Errors } = $props()
  const t = useT()
</script>

<AuthCard title={t('auth.register.title')}>
  <Title text={t('auth.register.title')} />
  <Form action={route('register')} method="post" resetOnError={['password', 'password_confirmation']}>
    {#snippet children({ errors, processing })}
      <Field name="name" label={t('auth.fields.name')} error={errors.name}>
        <Input autocomplete="name" />
      </Field>
      <Field name="email" label={t('auth.fields.email')} error={errors.email}>
        <Input type="email" autocomplete="email" />
      </Field>
      <Field name="password" label={t('auth.fields.password')} error={errors.password}>
        <Input type="password" autocomplete="new-password" />
      </Field>
      <Field name="password_confirmation" label={t('auth.fields.password_confirmation')} error={errors.password_confirmation}>
        <Input type="password" autocomplete="new-password" />
      </Field>
      <Actions>
        <Button disabled={processing}>{t('auth.register.submit')}</Button>
      </Actions>
    {/snippet}
  </Form>
  <SocialButtons {social} error={typeof pageErrors.social === 'string' ? pageErrors.social : undefined} />
  <Note>
    {t('auth.register.have_account')} <Link href={route('login')}>{t('auth.login.title')}</Link>
  </Note>
</AuthCard>
