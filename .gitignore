# Build output
/bin/
/dist/
*.test
*.out
coverage.*
# Binaries `go build` leaves in example modules (exact paths: a pattern
# like /examples/*/database would also hide examples/saas/database/)
/examples/auth/auth
/examples/files/files
/examples/database/database
/examples/forms/forms
/examples/pubsub/pubsub
/examples/queue/queue
/examples/saas/saas
/examples/lifecycle/lifecycle
/examples/notes/notes
/examples/validation/validation
/examples/teams/teams
/examples/assistant/assistant
/examples/i18n/i18n
/examples/ai/ai
/examples/audit/audit
/examples/admin/admin
/examples/tracker/tracker
/examples/tutorial/tracker
/cli/cmd/anetos/anetos

# Local environment
.env
.env.*
!.env.example

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store

# Files saved by the Claude desktop app
/Claude outputs/

# Files the local storage disk writes in examples
/examples/*/storage/

# SQLite databases
*.db
*.db-shm
*.db-wal
