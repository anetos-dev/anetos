{
  "openapi": "3.1.0",
  "info": {
    "title": "Shop",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/echo": {
      "post": {
        "tags": [
          "Products"
        ],
        "operationId": "Products.Echo",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductResponseInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidValues"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": []
      }
    },
    "/api/v1/files/{path}": {
      "get": {
        "operationId": "get_api_v1_files_path",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "$ref": "#/components/responses/InvalidValues"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": []
      }
    },
    "/api/v1/legacy": {
      "get": {
        "tags": [
          "Products"
        ],
        "operationId": "Products.Legacy",
        "responses": {
          "2XX": {
            "description": "The handler's response (a web.Responder)."
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": []
      }
    },
    "/api/v1/products": {
      "get": {
        "tags": [
          "Products"
        ],
        "operationId": "api.products.index",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "name",
                    "-name"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^\\s*$"
                }
              ]
            }
          },
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "X-Trace-ID",
            "in": "header",
            "description": "Echoed in the logs.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageProductResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidValues"
          },
          "422": {
            "$ref": "#/components/responses/InvalidInput"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": []
      }
    },
    "/api/v1/products/{id}": {
      "get": {
        "tags": [
          "Products"
        ],
        "operationId": "api.products.show",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidValues"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": []
      },
      "put": {
        "tags": [
          "Products"
        ],
        "operationId": "api.products.update",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidValues"
          },
          "401": {
            "description": "No token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/InvalidInput"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Products"
        ],
        "operationId": "api.products.delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "$ref": "#/components/responses/InvalidValues"
          },
          "401": {
            "description": "No token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Not an admin.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": [
              "*"
            ]
          }
        ]
      }
    },
    "/api/v1/uploads": {
      "post": {
        "tags": [
          "Products"
        ],
        "operationId": "Products.Upload",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "title",
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "400": {
            "$ref": "#/components/responses/InvalidValues"
          },
          "401": {
            "description": "No token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/InvalidInput"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Owner": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "manager": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Owner"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name"
        ]
      },
      "OwnerInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "manager": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OwnerInput"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "PageProductResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductResponse"
            }
          },
          "current_page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "last_page": {
            "type": "integer"
          }
        },
        "required": [
          "data",
          "current_page",
          "per_page",
          "total",
          "last_page"
        ]
      },
      "Problem": {
        "type": "object",
        "description": "Problem details (RFC 9457).",
        "properties": {
          "type": {
            "type": "string",
            "description": "\"about:blank\": the status says what happened."
          },
          "title": {
            "type": "string",
            "description": "The status's title, in the request's language."
          },
          "status": {
            "type": "integer",
            "description": "The HTTP status."
          },
          "detail": {
            "type": "string",
            "description": "What went wrong, for people."
          },
          "errors": {
            "type": "object",
            "description": "A message per field of the request that has a problem.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "request_id": {
            "type": "string",
            "description": "The request's ID, as in the logs."
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ]
      },
      "ProductInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "price": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "not": {
              "const": 0
            }
          },
          "stock": {
            "type": "string"
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "format": "email"
              },
              {
                "type": "string",
                "pattern": "^\\s*$"
              }
            ]
          },
          "kind": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "a",
                  "b"
                ]
              },
              {
                "type": "string",
                "pattern": "^\\s*$"
              }
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 5,
            "uniqueItems": true
          },
          "code": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 3,
                "maxLength": 3
              },
              {
                "type": "string",
                "pattern": "^\\s*$"
              }
            ]
          },
          "meta": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "launch_on": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "owner": {
            "$ref": "#/components/schemas/OwnerInput"
          }
        },
        "required": [
          "name",
          "price"
        ]
      },
      "ProductResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "launch_on": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "notes": {
            "type": "string",
            "description": "Free text."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "owner": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Owner"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "price",
          "tags",
          "launch_on",
          "created_at",
          "owner"
        ]
      },
      "ProductResponseInput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "launch_on": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "notes": {
            "type": "string",
            "description": "Free text."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "owner": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OwnerInput"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "An error: problem details.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "InvalidInput": {
        "description": "The input isn't valid: problem details with an error per field.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "InvalidValues": {
        "description": "The request's values can't be read: problem details with an error per field.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "An API token, sent as \"Authorization: Bearer <token>\"."
      }
    }
  }
}
